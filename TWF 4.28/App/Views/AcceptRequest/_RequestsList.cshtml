                                <td>
                                    <label>@req.TypeName</label>
                                </td>
                                <td class="ltr">
                                    <label>@req.From</label>
                                </td>
                                <td class="ltr">
                                    <label>@req.To</label>
                                </td>
                                <td>
                                    <label>@(req.ForDeputy ? @req.DeputyTitleName : "-")</label>
                                </td>
                                <td>
                                    <label>@req.Descriptions</label>
                                    @if ((req.Latitude != 0) && (req.Longitude != 0))
                                    {
                                        <br />
                                        <a rel="noopener noreferrer" target="_blank" href="http://maps.google.com/maps?q=@req.Latitude,@req.Longitude">@MyTime3.Content.PersianString.ShowOnMap</a>
                                    }
