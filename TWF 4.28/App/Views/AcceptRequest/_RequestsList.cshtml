                        if (ViewBag.SortByDate == 1)
                        {
                            q = Model.OrderBy(d => d.RequestTime).ToList();
                        }

                        foreach (MyTime3.Models.Request req in q)
                        {
                            <tr>
                                <td>
                                    <div class="mat-check">
                                        <div class="exp">
                                            <div class="checkbox">
                                                <div class="text-center">
                                                    <input type="checkbox" id="check@(req.RequestID)" name="requestsChecked" value="@req.RequestID" />
                                                    <label for="check@(req.RequestID)">
                                                        <span></span>@*@string.Format("{0} - {1} {2}", per.BadgeNumber, per.FirstName, per.LastName)*@
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @*<input type="checkbox" name="requestsChecked" id="@req.RequestID" value="@req.RequestID" />*@
