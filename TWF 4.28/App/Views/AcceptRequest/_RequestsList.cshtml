@model IEnumerable<MyTime3.Models.Request>

@if (Model.Count() > 0)
{
    <div class="card-header text-right">
        <h3>
            @MyTime3.Content.PersianString.AcceptRequest
        </h3>
    </div>
    <style>
        table thead td {
            vertical-align: middle !important;
        }
    </style>
    <div class=" card">



        @using (Html.BeginForm("AcceptAll", "AcceptRequest", FormMethod.Post, new { @id = "myForm" }))
        {
            bool prePageIsHome = false;
            if ((ViewData["fromHome"] != null) && ((bool)ViewData["fromHome"]))
            {
                prePageIsHome = true;
            }

            <table class="table table-hover table-bordered table-responsive table-striped">
                <thead>
                    <tr>
                        <td>
                            <div class="dropdown dropdown-menu-left">
                                <button style="padding:3px 3px 0px 3px" class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown">
                                    @*<i class="fa fa-check-square-o fa-2x"></i>*@
                                    @MyTime3.Content.PersianString.Select
                                    <i class="fa fa-caret-down"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li style="cursor:pointer" onclick="checkAllRequests()"><a  rel="noopener noreferrer">@MyTime3.Content.PersianString.All</a></li>
                                    <li style="cursor:pointer" onclick="reverseAllRequests()"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.Reverse</a></li>
                                </ul>
                            </div>
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.BadgeNumber
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.Name
                            @if (prePageIsHome)
                            {
                                <text>
                                    (
                                    گروهبندی
                                    <div class="mat-check" style="display:inline-block;vertical-align:bottom">
                                        <div class="exp">
                                            <div class="checkbox">
                                                <div class="text-center">
                                                    @if ((bool)ViewBag.GroupByName)
                                                    {
                                                        <input type="checkbox" onchange="chgr(this)" checked="checked" id="checg" />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" onchange="chgr(this)" id="checg" />
                                                    }
                                                    <label for="checg">
                                                        <span></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    )
                                </text>
                                @*<a class="btn" href="/Home/Index/">(گروهبندی)</a>*@
                            }
                            else
                            {
                                <text>
                                    (
                                    گروهبندی
                                    <div class="mat-check" style="display:inline-block;vertical-align:bottom">
                                        <div class="exp">
                                            <div class="checkbox">
                                                <div class="text-center">
                                                    @if ((bool)ViewBag.GroupByName)
                                                    {
                                                        <input type="checkbox" onchange="chgrreq(this)" checked="checked" id="checg" />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" onchange="chgrreq(this)" id="checg" />
                                                    }
                                                    <label for="checg">
                                                        <span></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    )
                                </text>
                            }
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.WorkflowType
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.RequestTime
                            @if (prePageIsHome)
                            {
                                if ((ViewBag.SortByDate != null) && (ViewBag.SortByDate == 1))
                                {
                                    <a rel="noopener noreferrer" class="btn" href="/Home/Index?Sort=2&g=@(((bool)ViewBag.GroupByName).ToString())"><i class="fa fa-sort-amount-asc"></i></a>
                                }
                                else
                                {
                                    <a rel="noopener noreferrer" class="btn" href="/Home/Index?Sort=1&g=@(((bool)ViewBag.GroupByName).ToString())"><i class="fa fa-sort-amount-desc"></i></a>
                                }
                            }
                            else
                            {
                                if ((ViewBag.SortByDate != null) && (ViewBag.SortByDate == 1))
                                {
                                    <a rel="noopener noreferrer" class="btn" href="/AcceptRequest/Index?Sort=2&g=@(((bool)ViewBag.GroupByName).ToString())"><i class="fa fa-sort-amount-asc"></i></a>
                                }
                                else
                                {
                                    <a rel="noopener noreferrer" class="btn" href="/AcceptRequest/Index?Sort=1&g=@(((bool)ViewBag.GroupByName).ToString())"><i class="fa fa-sort-amount-desc"></i></a>
                                }

                            }
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.Type
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.From
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.To
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.Deputy
                        </td>
                        <td>
                            @MyTime3.Content.PersianString.Descriptions
                        </td>
                        <td>
                            @if ((bool)ViewBag.GroupByName)
                            {
                                <a rel="noopener noreferrer" href="javascript:collapser(-1)">
                                    <span class="fa-stack ">
                                        <i class="fa fa-square-o fa-stack-2x"></i>
                                        <i data-b="-1" class="fa  fa-plus fa-stack-1x"></i>
                                    </span>
                                </a>
                            }
                        </td>

                    </tr>
                </thead>
                <tbody>
                    @if (!((bool)ViewBag.GroupByName))
                    {
