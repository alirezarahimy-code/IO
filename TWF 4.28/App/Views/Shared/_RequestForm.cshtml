@model MyTime3.Models.GeneralRequest
@section TopStyle{
    <link href="~/Content/style.css" rel="stylesheet" />
}
@section EndScript{
    <script src="~/Scripts/index.js"></script>
    <script>

        settings = {
            format: "yyyy/mm/dd",
            dateSeparator: "/",
            autoClose: true,
            labelLanguage: 'farsi'
        }
        renderToday();
    </script>
}
<div class="material-input text-right">
    <div class="col-sm-8 col-sm-offset-1">
        <div class="group">
            <div class="material-dropdown">
                <div class="dropdown">
                    @if (Model != null)
                    {
                        <input type="hidden" value="@Model.RequestType" name="RequestType" id="requestTypeID">
                        <input data-toggle="dropdown" value="@Model.RequestType" id="selectedName" type="text">

                    }
                    else
                    {
                        <input type="hidden" name="RequestType" id="requestTypeID">
                        <input data-toggle="dropdown" id="selectedName" type="text">
                    }


                    <span class="highlight"></span>
                    <span class="bar"></span>
                    <label>@MyTime3.Content.PersianString.Request</label>

                    <ul class="dropdown-menu">
                        <li onclick="showValidTypes(0, true, '@MyTime3.Content.PersianString.DailyLeave')"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.DailyLeave</a></li>
                        <li onclick="showValidTypes(1, false, '@MyTime3.Content.PersianString.HourlyLeave')"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.HourlyLeave</a></li>
                        <li onclick="showValidTypes(2, true, '@MyTime3.Content.PersianString.DailyDuty')"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.DailyDuty</a></li>
                        <li onclick="showValidTypes(3, false, '@MyTime3.Content.PersianString.HourlyDuty')"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.HourlyDuty</a></li>
                        <li onclick="showValidTypes(4, false, '@MyTime3.Content.PersianString.InsertRecord')"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.InsertRecord</a></li>
                        @if ((bool)MyTime3.Controllers.SettingsController.LoadValue("ValidLateEarly", typeof(bool), true))
                        {
                            <li onclick="showValidTypes(5, false, '@MyTime3.Content.PersianString.RequestLate')"><a rel="noopener noreferrer" href="#">@MyTime3.Content.PersianString.RequestLate</a></li>
                            <li onclick="showValidTypes(6, false, '@MyTime3.Content.PersianString.RequestEarly')"><a rel="noopener noreferrer" href="#">@MyTime3.Content.PersianString.RequestEarly</a></li>
                        }
                        <li onclick="showValidTypes(7, false, '@MyTime3.Content.PersianString.OverTimeAccess')"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.OverTimeAccess</a></li>
                    </ul>

                </div>

                <span class="caret"></span>
            </div>
        </div>
    </div>
</div>


<div id="typeGroup" class="material-input text-right">
    <div class="col-sm-8 col-sm-offset-1">
        <div class="group">
            <div class="material-dropdown">
                <div class="dropdown">

                    <input type="hidden" name="LeaveTypeID" id="LeaveTypeID">
                    <input data-toggle="dropdown" id="LeaveTypeName" type="text">


                    <span class="highlight"></span>
                    <span class="bar"></span>
                    <label>@MyTime3.Content.PersianString.Type</label>

                    <ul id="validTypes" class="dropdown-menu"></ul>

                    <ul id="allTypes" class="collapsed-visibility">
                        <li data-id="-1" data-parent="7" onclick="dropdownChanged('LeaveTypeID','LeaveTypeName','@MyTime3.Content.PersianString.OverTimeAfter', -1)"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.OverTimeAfter</a></li>
                        <li data-id="-2" data-parent="7" onclick="dropdownChanged('LeaveTypeID','LeaveTypeName','@MyTime3.Content.PersianString.OverTimeBefore', -2)"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.OverTimeBefore</a></li>
                        <li data-id="-3" data-parent="7" onclick="dropdownChanged('LeaveTypeID','LeaveTypeName','@MyTime3.Content.PersianString.FreeOverTime', -3)"><a rel="noopener noreferrer">@MyTime3.Content.PersianString.FreeOverTime</a></li>


                        @foreach (T5V3.Model.LeaveType lt in ViewBag.LeaveTypes)
                        {
                            if (lt.LeaveType1 == T5V3.Model.LeaveTypeEnum.Leave)
                            {
                                if (lt.IsHourly)
                                {
                                    <li data-id="@lt.LeaveTypeID" data-parent="1" onclick="dropdownChanged('LeaveTypeID','LeaveTypeName','@lt.LeaveName', @lt.LeaveTypeID)"><a rel="noopener noreferrer">@lt.LeaveName</a></li>
                                }
                                else
                                {
                                    <li data-id="@lt.LeaveTypeID" data-parent="0" onclick="dropdownChanged('LeaveTypeID','LeaveTypeName','@lt.LeaveName', @lt.LeaveTypeID)"><a rel="noopener noreferrer">@lt.LeaveName</a></li>
                                }
                            }
                            else if (lt.LeaveType1 == T5V3.Model.LeaveTypeEnum.Duty)
                            {
                                if (lt.IsHourly)
                                {
                                    <li data-id="@lt.LeaveTypeID" data-parent="3" onclick="dropdownChanged('LeaveTypeID','LeaveTypeName','@lt.LeaveName', @lt.LeaveTypeID)"><a rel="noopener noreferrer">@lt.LeaveName</a></li>
                                }
                                else
                                {
                                    <li data-id="@lt.LeaveTypeID" data-parent="2" onclick="dropdownChanged('LeaveTypeID','LeaveTypeName','@lt.LeaveName', @lt.LeaveTypeID)"><a rel="noopener noreferrer">@lt.LeaveName</a></li>
                                }
                            }
                        }
                    </ul>

                </div>

                <span class="caret"></span>
            </div>
        </div>
    </div>
</div>



<div id="date-interval">
    <div class="material-input date-input text-right">
        <div class="col-sm-8 col-sm-offset-1">
            <div class="group">
                @*<input value="@(Model != null ? Model.FromDateHijri : " ")" name="FromDateHijri" type="text">*@
                <input value="@(Model != null ? Model.FromDateHijri : " ")"  class="" name="FromDateHijri" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.FromDate</label>
            </div>
        </div>
        <div id="dtshow"></div>

        @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('FromDateHijri', this,null,null,'dtshow','datepicker1')">@MyTime3.Content.PersianString.SelectDate</a>*@
    </div>


    <div class="material-input date-input text-right">
        <div class="col-sm-8 col-sm-offset-1">
            <div class="group">
                @*<input value="@(Model != null ? Model.ToDateHijri : " ")" name="ToDateHijri" type="text">*@
                <input value="@(Model != null ? Model.ToDateHijri : " ")"  name="ToDateHijri" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.ToDate</label>
            </div>
        </div>
        <div id="dttoDate"></div>

        @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('ToDateHijri', this,null,null,'dttoDate','datepicker2')">@MyTime3.Content.PersianString.SelectDate</a>*@
    </div>

</div>

<div id="divForDate">

    <div class="material-input date-input text-right">
        <div class="col-sm-8 col-sm-offset-1">
            <div class="group">
                @*<input value="@(Model != null ? Model.ForDateHijri : " ")" name="ForDateHijri" type="text">*@
                <input value="@(Model != null ? Model.ForDateHijri : " ")" name="ForDateHijri" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.Date</label>
            </div>
        </div>
        <div id="dtforDate"></div>
        @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('ForDateHijri', this,null,null,'dtforDate','datepicker3')">@MyTime3.Content.PersianString.SelectDate</a>*@
    </div>
</div>

<div id="divForTime" class="">

    <div class="material-input text-right">
        <div class="col-sm-offset-1 col-sm-8">
            <div class="group">
                <input name="ForTime" value="@(Model != null ? Model.ForTime : " ")" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.Time</label>
            </div>
        </div>
    </div>
</div>

<div id="divTimeInterval">
    <div class="material-input text-right">
        <div class="col-sm-offset-1 col-sm-8">
            <div class="group">
                <input name="FromTime" value="@(Model != null ? Model.FromTime : " ")" class="timeInput" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.FromTime</label>
            </div>
        </div>
    </div>
    <div class="material-input text-right">
        <div class="col-sm-offset-1 col-sm-8">
            <div class="group">
                <input name="ToTime" value="@(Model != null ? Model.ToTime : " ")" class="timeInput" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.ToTime</label>
            </div>
        </div>
    </div>


</div>

<div id="divOT" class="">
    <div class="material-input text-right">
        <div class="col-sm-offset-1 col-sm-8">
            <div class="group">
                <input name="OvertimeValue" value="@(Model != null ? Model.OvertimeValue : "")" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.Value</label>
            </div>
        </div>
    </div>


</div>

<div id="descGroup">
    <div class="material-input text-right">
        <div class="col-sm-8 col-sm-offset-1">
            <div class="group">
                <div class="material-dropdown">

                    <ul id="allDescriptions" class="collapsed-visibility">
                        @foreach (T5V3.Model.LeaveDescription ld in ViewBag.LeaveDescriptions)
                        {
                            if (ld.ForLeaveType == T5V3.Model.LeaveTypeEnum.Leave)
                            {
                                <li data-parent="1" onclick="dropdownChanged('validDescriptions','LeaveDescriptionsName','@ld.Description', @ld.ID)"><a rel="noopener noreferrer">@ld.Description</a></li>
                            }
                            else
                            {
                                <li data-parent="0" onclick="dropdownChanged('validDescriptions','LeaveDescriptionsName','@ld.Description', @ld.ID)"><a rel="noopener noreferrer">@ld.Description</a></li>
                            }
                        }

                    </ul>

                    <div class="dropdown">
                        <input id="validDescriptions" name="LeaveDescriptionsID" type="hidden" value="@(Model != null ? Model.LeaveDescriptionsID : - 1)">
                        <input data-toggle="dropdown" id="LeaveDescriptionsName" value="" type="text">

                        <span class="highlight"></span>
                        <span class="bar"></span>
                        <label>@MyTime3.Content.PersianString.LeaveDescriptions</label>


                        <ul id="validDescriptionsUL" class="dropdown-menu"></ul>

                    </div>

                    <span class="caret"></span>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="divDesc">
    <div class="material-input text-right">
        <div class="col-sm-offset-1 col-sm-8">
            <div class="group">
                <input name="Descriptions" value="@(Model!=null  ? Model.Descriptions  : "")" type="text">
                <span class="highlight"></span>
                <span class="bar"></span>
                <label>@MyTime3.Content.PersianString.Descriptions</label>
            </div>
        </div>
    </div>
</div>



<script>
    showValidTypes(@(Model.RequestType) , 0 , '@(Model.RequestTypeStr)' );

    $(document).ready(function () {
        @*$('.timeInput').ptTimeSelect({
            popupImage: '@MyTime3.Content.PersianString.SelectTime',
            hoursLabel: '@MyTime3.Content.PersianString.Hour',
            minutesLabel: '@MyTime3.Content.PersianString.Minute',
            setButtonLabel: '@MyTime3.Content.PersianString.OK'
        });*@
    });

    function showValidTypes(req, daily, name) {

        $("#requestTypeID").val(req);
        $("#selectedName").val(name);
        //var req = $("#requestTypeID").val();

        $("#allTypes").append($("#validTypes li"));
        $("#validTypes").append($("#allTypes [data-parent=" + req + "]"));

        if (req == 0 || req == 1) {
            $("#allDescriptions").append($("#validDescriptionsUL li"));
            $("#validDescriptionsUL").append($("#allDescriptions [data-parent=1]"));
        }
        else if (req == 2 || req == 3) {
            $("#allDescriptions").append($("#validDescriptionsUL li"));
            $("#validDescriptionsUL").append($("#allDescriptions [data-parent=0]"));
        }

        $("#LeaveTypeID").val($("#validTypes li:first").data("id"));
        $("#LeaveTypeName").val($("#validTypes:first a").html());

        $("#date-interval").addClass("collapsed-visibility");
        $("#divForDate").addClass("collapsed-visibility");
        $("#divForTime").addClass("collapsed-visibility");
        $("#divTimeInterval").addClass("collapsed-visibility");
        $("#divOT").addClass("collapsed-visibility");
        $("#descGroup").addClass("collapsed-visibility");


        if ((req==0)||(req==2)) {//($("#requestType [value=" + req + "]:first").data("daily") == 1) {
            $("#date-interval").removeClass("collapsed-visibility");
            $("#descGroup").removeClass("collapsed-visibility");
        }

        if ((req == 1) || (req == 3)) {
            $("#divForDate").removeClass("collapsed-visibility");
            $("#descGroup").removeClass("collapsed-visibility");
            $("#divTimeInterval").removeClass("collapsed-visibility");
        }

        if (req == 4) {
            $("#divForDate").removeClass("collapsed-visibility");
            $("#divForTime").removeClass("collapsed-visibility");
        }

        if ((req == 5) || (req == 6)) {
            $("#divForDate").removeClass("collapsed-visibility");
        }

        if (req == 7) {
            $("#divOT").removeClass("collapsed-visibility");
            $("#divForDate").removeClass("collapsed-visibility");
        }

        if ((req < 4) || (req == 7)) {
            $("#typeGroup").removeClass("collapsed-visibility");
        }
        else
            $("#typeGroup").addClass("collapsed-visibility");
    }
</script>
