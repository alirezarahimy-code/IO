<style>
    .toolItem {
        display: inline-block;
        margin: 1em 1em 0 1em;
        transition: 0.3s;
    }

    .toolItem a { @(MyTime3.Controllers.HomeController.ToolbarShow(Context) ? "color:#03a9f4 " : " color: white;")
        }


        .toolItem:hover {
            transform: scale(1.2,1.2);
        }
</style>

<div id="toolbarmaindiv" @(MyTime3.Controllers.HomeController.ToolbarShow(Context) ? "class=hideToolbar" : "") style="transition: all 0.5s; padding: 5px; color: white; top: -25px; position: relative;">
    <div class="row text-center">

        <div id="tooldiv1" style="margin: auto; display: table; background-color: #03a9f4;">
            <div id="tooldiv2" style="z-index: -10; position: absolute; margin: auto; display: table; background-color: white; border-style: solid; border-color: #03a9f4 transparent transparent transparent;border-width:7em;right:50%;transform:translateX(50%)">
                <span> </span>
                <div></div>
            </div>
            <div>
                @{
                    List<int> items = MyTime3.Controllers.HomeController.GetToolbars(Context);
                }

                @if (items.Contains(1))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/">
                            <i class="fa fa-3x fa-home"></i><br />
                            <span>@MyTime3.Content.PersianString.HomePage</span>
                        </a>
                    </div>
                }

                @if (items.Contains(2))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/request/new/">
                            <i class="fa fa-3x fa-plus-circle"></i><br />
                            <span>@MyTime3.Content.PersianString.NewRequest</span>
                        </a>
                    </div>
                }

                @if (items.Contains(3))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/request/FromUser/">
                            <i class="fa fa-3x fa-user-plus"></i><br />
                            <span>@MyTime3.Content.PersianString.RequestFromUser</span>
                        </a>
                    </div>
                }
                @if (items.Contains(4))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/EditRequest/Index/">
                            <i class="fa fa-3x fa-edit"></i><br />
                            <span>@MyTime3.Content.PersianString.EditRequest</span>
                        </a>
                    </div>
                }
                @if (items.Contains(5))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/AcceptRequest/Index/">
                            <i class="fa fa-3x fa-check-square-o"></i><br />
                            <span>@MyTime3.Content.PersianString.AcceptRequest</span>
                        </a>
                    </div>
                }
                @if (items.Contains(6))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/ShowRequest/Index/">
                            <i class="fa fa-3x fa-list"></i><br />
                            <span>@MyTime3.Content.PersianString.RequestsStatus</span>
                        </a>
                    </div>
                }
                @if (items.Contains(7))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/Deputy/Index/">
                            <i class="fa fa-3x fa-user-circle"></i><br />
                            <span>@MyTime3.Content.PersianString.Deputy</span>
                        </a>
                    </div>
                }
                @if (items.Contains(8))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/ConstOT/Index/">
                            <i class="fa fa-3x fa-group"></i><br />
                            <span>@MyTime3.Content.PersianString.ConstOT</span>
                        </a>
                    </div>
                }
                @if (items.Contains(9))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/Reward/Add/">
                            <i class="fa fa-3x fa-gift"></i><br />
                            <span>@MyTime3.Content.PersianString.RewardAndPenalty</span>
                        </a>
                    </div>
                }
                @if (items.Contains(10))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/SelectArea/Index/">
                            <i class="fa fa-3x fa-map-marker"></i><br />
                            <span>@MyTime3.Content.PersianString.SelectValidArea</span>
                        </a>
                    </div>
                }

                @if (items.Contains(12))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/report/index/">
                            <i class="fa fa-3x fa-file-text-o"></i><br />
                            <span>@MyTime3.Content.PersianString.Report</span>
                        </a>
                    </div>
                }
                @if (items.Contains(13))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/remainleave/index/">
                            <i class="fa fa-3x fa-bar-chart"></i><br />
                            <span>@MyTime3.Content.PersianString.RemainLeave</span>
                        </a>
                    </div>
                }

                @if (items.Contains(14))
                {
                    <div class="toolItem">
                        <a rel="noopener noreferrer" href="/PersonnelStatus/index/">
                            <i class="fa fa-3x fa-list-alt"></i><br />
                            <span>@MyTime3.Content.PersianString.PersonnelStatus</span>
                        </a>
                    </div>
                }

            </div>

            <div>
                <div class="col-xs-6 text-left">
                    <a rel="noopener noreferrer" href="javascript:shtb()" style="color: white; vertical-align: bottom"><i id="toolbarShowHide" class="fa @(MyTime3.Controllers.HomeController.ToolbarShow(Context) ? "fa-chevron-circle-down" : "fa-chevron-circle-up") "></i></a>
                </div>
                <div class="text-right col-xs-6">
                    <a rel="noopener noreferrer" href="javascript:tbstt()" style="color:white; vertical-align:bottom"><i class="fa fa-pencil-square-o"></i></a>
                </div>
            </div>
          
        </div>
    </div>
</div>

<script>
    window.onresize = new function () {
        $("#tooldiv2").width($("#tooldiv1").width());
    }
</script>