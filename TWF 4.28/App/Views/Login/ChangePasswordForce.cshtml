@model MyTime3.Models.ChangePasswordModel
@{
    ViewBag.Title = MyTime3.Content.PersianString.ChangePassword;
    ViewBag.NoMenu = true;
    var f = Request.Params["Force"].AsBool();
    var m = Request.Params["Message"].AsInt();

    var mes = string.Empty;

    switch (m)
    {
        case 1:
            mes = "به منظور مسایل امنیتی، شما موظف به جایگزینی رمز عبور جدید هستید.";
            break;
        case 2:
            mes = "مدت زیادی از آخرین تغییر رمز عبور شما گذشته است. به منظور مسایل امنیتی، شما موظف به جایگزینی رمز عبور جدید هستید.";
            break;
    }
}

<div style="max-width:400px;margin:auto">
    <div class="card-header text-right">
        <h3>@Html.Raw(MyTime3.Content.PersianString.ChangePassword)</h3>
    </div>

    <div class="card">

        <form action="/Login/ChangePasswordForce" class="form-horizontal changePasswordForceForm" method="post">
            <div class="material-input text-right">
                <div class="col-sm-offset-1 col-lg-8 col-sm-8">
                    <div class="group">
                        <input name="OldPassword" id="OldPassword" type="password" required>
                        <span class="highlight"></span>
                        <span class="bar"></span>
                        <label>@MyTime3.Content.PersianString.OldPassword</label>
                    </div>
                </div>
                <div class="col-sm-offset-1 col-lg-4 col-sm-4" style="margin-right: 0px">
                    <label for="OldPassword" generated="true" class="error " style="font-size: 12px; margin-top: 69px; "></label>
                </div>
            </div>

            @*<div class="form-group">
                    <div class="col-sm-3 text-left">
                        @Html.Label(MyTime3.Content.PersianString.OldPassword, new { @class = "control-label" })
                    </div>
                    <div class="col-sm-3 text-right">
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
                    </div>
                </div>*@


            <div class="material-input text-right">
                <div class="col-sm-offset-1 col-lg-8 col-sm-8">
                    <div class="group">
                        <input name="NewPassword" id="NewPassword" type="password" required>
                        <span class="highlight"></span>
                        <span class="bar"></span>
                        <label>@MyTime3.Content.PersianString.NewPassword</label>
                    </div>
                </div>
                <div class="col-sm-offset-1 col-lg-4 col-sm-4" style="margin-right: 0px">
                    <label for="NewPassword" generated="true" class="error " style="font-size: 12px; margin-top: 69px; "></label>
                </div>
            </div>


            @*<div class="form-group">
                    <div class="col-sm-3 text-left">
                        @Html.Label(MyTime3.Content.PersianString.NewPassword, new { @class = "control-label" })
                    </div>
                    <div class="col-sm-3 text-right">
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                    </div>
                </div>*@


            <div class="material-input text-right">
                <div class="col-sm-offset-1 col-lg-8 col-sm-8">
                    <div class="group">
                        <input name="ConfirmPassword" id="ConfirmPassword" type="password" required>
                        <span class="highlight"></span>
                        <span class="bar"></span>
                        <label>@MyTime3.Content.PersianString.ConfirmPassword</label>
                    </div>
                </div>
                <div class="col-sm-offset-1 col-lg-4 col-sm-4" style="margin-right: 0px">
                    <label for="ConfirmPassword" generated="true" class="error " style="font-size: 12px; margin-top: 69px; "></label>
                </div>
            </div>

            @*<div class="form-group">
                    <div class="col-sm-3 text-left">
                        @Html.Label(MyTime3.Content.PersianString.ConfirmPassword, new { @class = "control-label" })
                    </div>
                    <div class="col-sm-3 text-right">
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                    </div>
                </div>*@

            <div class="form-group"></div>
            <div class="form-group top-buffer">
                <input type="submit" class="btn btn-lg btn-primary btn-shadow" value="@MyTime3.Content.PersianString.OK" />
            </div>

            @if (ViewBag.Message != null)
            {
            <div>
                <div class="text-center panel-danger panel">
                    <div class="panel-heading">
                        <label>@ViewBag.Message</label>
                    </div>
                </div>
            </div>
            }

            <div class="text-center text-danger">
                <label>@mes</label>
            </div>


        </form>

    </div>
</div>

<script src="~/Scripts/jquery-3.6.1.js"></script>
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/additional-methods.js"></script>
<script>
    $(document).ready(function () {
        $(".changePasswordForceForm").validate({
            rules: {
                OldPassword: {
                    required: true,
                    alphanumeric: true
                },
                NewPassword: {
                    required: true,
                    alphanumeric: true,
                    minlength: 5
                }
                , ConfirmPassword: {
                    required: true,
                    alphanumeric: true,
                    minlength: 5
                }
            },
            submitHandler: function (form) {
                $('.changePasswordForceForm').submit();
                return true;
            }
        });
    });
</script>