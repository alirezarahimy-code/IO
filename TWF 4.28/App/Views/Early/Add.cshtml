@model MyTime3.Models.LateEarlyRequest
@Styles.Render("~/Content/Request.css")
@Styles.Render("~/Content/Calendar.css")
@Scripts.Render("~/Scripts/JsFarsiCalendar.js")
@{
    ViewBag.Title = MyTime3.Content.PersianString.RequestEarly;
}
@section TopStyle{
    <link href="~/Content/style.css" rel="stylesheet" />
}
@section EndScript{
    <script src="~/Scripts/index.js"></script>
    <script>

        settings = {
            format: "yyyy/mm/dd",
            dateSeparator: "/",
            autoClose: true,
            labelLanguage: 'farsi'
        }
        renderToday();
    </script>
}
<h3 class="pageHeader">@Html.Raw(MyTime3.Content.PersianString.RequestEarly)</h3>

@using (@Html.BeginForm("Add", "Early", FormMethod.Post, new { @class = "form" }))
{
    <ul class="form">
        <li>
            @Html.Label(MyTime3.Content.PersianString.Date, new { @class = "formLabel" })
            @Html.TextBoxFor(m => m.ForDateStr, new { @class = "formInput datepicker-farsi" })
            @*@Html.TextBoxFor(m => m.ForDateStr, new { @class = "formInput" })*@
            @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('ForDateStr', this)">@MyTime3.Content.PersianString.SelectDate</a>*@
        </li>
        <li>
            @Html.Label(MyTime3.Content.PersianString.Descriptions, new { @class = "formLabel" })
            @Html.TextBoxFor(m => m.Descriptions, new { @class = "formInput" })
        </li>

        <li>
            <input type="submit" class="formSubmit" value="@MyTime3.Content.PersianString.OK" />
        </li>

        <li>
            <label class="messageLabel">@ViewBag.Message</label>
        </li>
    </ul>
}
