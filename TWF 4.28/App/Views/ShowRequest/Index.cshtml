@model MyTime3.Models.ShowRequestModel
@{
    ViewBag.Title = MyTime3.Content.PersianString.RequestsStatus;
}
@section TopStyle{
    <link href="~/Content/style.css" rel="stylesheet" />
}
@section EndScript{
    <script src="~/Scripts/index.js"></script>
    <script>

        settings = {
            format: "yyyy/mm/dd",
            dateSeparator: "/",
            autoClose: true,
            labelLanguage: 'farsi'
        }
        renderToday();
    </script>
}
<div class="text-right card-header">
    <h3>@MyTime3.Content.PersianString.RequestsStatus</h3>
</div>

<div class="card">
    <div class="form">
        @using (@Html.BeginForm("Index", "ShowRequest", FormMethod.Get, new { @class = "form-horizontal" }))
        {

            <div class="material-input date-input text-right">
                <div class="col-sm-4 col-sm-offset-1">
                    <div class="group">
                        @if (Model != null)
                        {
                            @*<input name="fromDate" type="text" value="@Model.fromDate" required>*@
                            <input value="@Model.fromDate" class="datepicker-farsi" name="fromDate" type="text" required>

                        }
                        else
                        {
                            @*<input name="fromDate" type="text" required>*@
                            <input class="datepicker-farsi" name="fromDate" type="text" required>
                        }
                        <span class="highlight"></span>
                        <span class="bar"></span>
                        <label>@MyTime3.Content.PersianString.FromDate</label>
                    </div>
                </div>
                <div id="fromdatediv"></div>
                @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('fromDate', this,null,null,'fromdatediv')">@MyTime3.Content.PersianString.SelectDate</a>*@
            </div>


            <div class="material-input date-input text-right">
                <div class="col-sm-4 col-sm-offset-1">
                    <div class="group">
                        @if (Model != null)
                        {
                            @*<input name="toDate" type="text" value="@Model.toDate" required>*@
                            <input value="@Model.toDate" class="datepicker-farsi" name="toDate" type="text" required>
                        }
                        else
                        {
                            @*<input name="toDate" type="text" required>*@
                            <input class="datepicker-farsi" name="toDate" type="text" required>
                        }
                        <span class="highlight"></span>
                        <span class="bar"></span>
                        <label>@MyTime3.Content.PersianString.ToDate</label>
                    </div>
                </div>

                <div id="todatediv"></div>
                @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('toDate', this, null, null, 'todatediv')">@MyTime3.Content.PersianString.SelectDate</a>*@
            </div>


            @*<div class="form-group">
                    <div class="col-sm-2 text-left">
                        @Html.Label(MyTime3.Content.PersianString.FromDate, new { @class = "formLabel" })
                    </div>
                    <div class="col-sm-4 text-right">
                        @Html.TextBoxFor(m => m.fromDate, new { @class = "formInput" })
                        <a href="javascript:" onclick="displayDatePicker('fromDate', this)">@MyTime3.Content.PersianString.SelectDate</a>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-sm-2 text-left">
                        @Html.Label(MyTime3.Content.PersianString.FromDate, new { @class = "formLabel" })
                    </div>
                    <div class="col-sm-4 text-right">
                        @Html.TextBoxFor(m => m.toDate, new { @class = "formInput" })
                        <a href="javascript:" onclick="displayDatePicker('toDate', this)">@MyTime3.Content.PersianString.SelectDate</a>
                    </div>
                </div>*@

            <div class="material-input text-right">
                <div class="col-sm-offset-1 col-sm-2">
                    <div class="group">
                        <button style="width:100%" class="btn btn-shadow btn-primary" type="submit">@MyTime3.Content.PersianString.OK</button>
                    </div>
                </div>
            </div>

            @*<div class="group">
                    <div class="col-sm-4 col-sm-offset-2 text-right">
                        <input type="submit" class="btn btn-accept" value="@MyTime3.Content.PersianString.OK" />
                    </div>
                </div>*@

            <div class="form-group">
                <label class="messageLabel">@ViewBag.Message</label>
            </div>
        }
    </div>

    <table class="table table-bordered table-hover table-responsive table-striped">
        <thead>
            <tr>
                <td>@MyTime3.Content.PersianString.BadgeNumber</td>
                <td>@MyTime3.Content.PersianString.Name</td>
                <td>@MyTime3.Content.PersianString.WorkflowType</td>
                <td>@MyTime3.Content.PersianString.Name</td>
                <td>@MyTime3.Content.PersianString.From</td>
                <td>@MyTime3.Content.PersianString.To</td>
                <td>@MyTime3.Content.PersianString.WaitForTitle</td>
                <td>@MyTime3.Content.PersianString.AcceptedTitle</td>
                <td>@MyTime3.Content.PersianString.CanceledTitle</td>
            </tr>
        </thead>
        <tbody>
            @foreach (MyTime3.Models.Request req in Model.Requests)
            {
                <tr>
                    <td>@req.BadgeNumber</td>
                    <td>@req.Name</td>
                    <td>@req.WorkflowName</td>
                    <td>@req.TypeName</td>
                    <td>@req.From</td>
                    <td>@req.To</td>
                    <td>@req.WaitForTitle</td>
                    <td>@req.AcceptedTitles</td>
                    <td>@req.CanceledTitle</td>
                </tr>
            }
        </tbody>

    </table>

</div>