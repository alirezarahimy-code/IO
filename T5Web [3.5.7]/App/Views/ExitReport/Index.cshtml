@model T5V3Web.Models.ExitReportModel
@{
    ViewBag.Title = T5V3Web.Content.Persian.LeavesReport;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.Reports;
    ViewBag.PageTag = "ExitReport";
}

<h3>@T5V3Web.Content.Persian.LeavesReport</h3>
<div class="horizontal-line"></div>

<form method="post" action="/ExitReport/Show">
    <div class="panel panel-default">
        <div class="panel-heading">
            <label>@T5V3Web.Content.Persian.SelectPersonnel ...</label>
        </div>
        <div class="panel-body">
            @Html.Partial("_SelectUser", T5V3Web.Controllers.UserSelectionController.CreateModel(Model.BadgeNumbers))
        </div>
    </div>


    <div class="panel panel-default">
        <div class="panel-heading">
            <label>@T5V3Web.Content.Persian.SelectTimeInterval ...</label>
        </div>
        <div class="panel-body">
            @Html.Partial("_SelectDateInterval", Model.Interval)
        </div>
    </div>


    <div>
        <input @(Model.DutyDaily ? "checked=\"checked\"" : "") type="checkbox" name="dutyDaily" value="true" />
        <input type="hidden" value="false" name="dutyDaily" />
        <label>@T5V3Web.Content.Persian.DailyDuty</label>
        <input @(Model.LeaveDaily ? "checked=\"checked\"" : "") type="checkbox" name="leaveDaily" value="true" />
        <input type="hidden" value="false" name="leaveDaily" />
        <label>@T5V3Web.Content.Persian.DailyLeave</label>
        <input @(Model.DutyHourly ? "checked=\"checked\"" : "") type="checkbox" name="dutyHourly" value="true" />
        <input type="hidden" value="false" name="dutyHourly" />
        <label>@T5V3Web.Content.Persian.HourlyDuty</label>
        <input @(Model.LeaveHourly ? "checked=\"checked\"" : "") type="checkbox" name="leaveHourly" value="true" />
        <input type="hidden" value="false" name="leaveHourly" />
        <label>@T5V3Web.Content.Persian.HourlyLeave</label>
    </div>
   

    <input class="btn btn-default mt-20 mb-20" value="@T5V3Web.Content.Persian.Show" type="submit" />
    <div class="form-group">
        <div class="col-sm-10 col-sm-offset-1 center-align">
            @if (Model.ValidationMessage != null)
            {
                <div class="@((T5V3Web.Models.ValidationMessageType)Model.ValidationMessageType == T5V3Web.Models.ValidationMessageType.Error ? "alert alert-danger fade in" : "alert alert-success fade in")">
                    @Model.ValidationMessage
                    <a rel="noopener noreferrer" href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                </div>
            }
        </div>
    </div>
</form>

<div class="horizontal-line mt-20"></div>

<div class="mt-10 mb-20">
    <button type="button" class="report-pre-page" onclick="prevPage()">@T5V3Web.Content.Persian.PreviousPage</button>
    <button type="button" class="report-next-page" onclick="nextPage()">@T5V3Web.Content.Persian.NextPage</button>
</div>

<input id="reportParams" type="hidden" value="@Model.ForQueryString()" />
<input id="reportPage" type="hidden" value="1" />
<iframe id="ifReport" class="block-display w-100p" style="height:1400px" src="/ExitReport/EXReport?@(Model.ForQueryString())"></iframe>
<div class="horizontal-line"></div>



<script>
    function nextPage() {
        var pageNumber = document.getElementById("reportPage").value;
        pageNumber++;
        document.getElementById("ifReport").src = "/ExitReport/EXReport?" + document.getElementById("reportParams").value + "&page=" + pageNumber;
        document.getElementById("reportPage").value = pageNumber;
    }

    function prevPage() {
        var pageNumber = document.getElementById("reportPage").value;
        pageNumber--;
        document.getElementById("ifReport").src = "/ExitReport/EXReport?" + document.getElementById("reportParams").value + "&page=" + pageNumber;
        document.getElementById("reportPage").value = pageNumber;
    }
</script>