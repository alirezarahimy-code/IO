                    @if (Model.HasNextPage)
                    {
                        <a data-toggle="tooltip" title="@T5V3Web.Content.Persian.Next" href="/EmpType?pageNumber=@(Model.PageNumber+1)"><span class="glyphicon glyphicon-backward"></span></a>
