                    </div>
                }
            </div>
        </div>

    </form>

    <div class="horizontal-line"></div>

    <table class="table table-responsive table-striped table-hover table-bordered">
        <thead>
            <tr class="warning">
                <td>@T5V3Web.Content.Persian.SelectDeleteEdit</td>
                <td>@T5V3Web.Content.Persian.EmpTypeName</td>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (Personnel.Model.EmpType c in Model.ItemsList)
                {
