@{
    ViewBag.Title = T5V3Web.Content.Persian.EmpType;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.BaseData;
    ViewBag.PageTag = "EmpType";
}

<div class="page-header">
    <h3>@T5V3Web.Content.Persian.EmpTypes</h3>
</div>

@{
    T5V3Web.Models.GridModel grd = new T5V3Web.Models.GridModel();
    grd.DeleteAllAPIPath = "/EmpType/DeleteAll";
    grd.DeleteAPIPath = "/EmpType/Delete/";
    grd.GetListAPIPath = "/EmpType/GetList";
    grd.IDPropertyName = "EmpTypeID";
    grd.DisplayPropertyName = "EmpTypeName";
    grd.Columns.Add(new T5V3Web.Models.GridModel.Column(T5V3Web.Content.Persian.EmpTypeName, "EmpTypeName"));
    @Html.Partial("_Grid", grd);
}

<div id="edit-panel" class="panel panel-default collapsed-visibility">
    <div class="panel-heading">
        <label id="title-panel-label">@T5V3Web.Content.Persian.Edit</label>
    </div>
    <div class="panel-body">
        <div class="form-horizontal">

            <input type="hidden" id="empTypeID" />
            <div class="form-group">
                <div class="col-sm-2 text-center">
                    <label class="control-label">@T5V3Web.Content.Persian.EmpTypeName <font style="color:red">*</font></label>
                </div>
                <div class="col-sm-10">
                    <input id="txtEmpTypeName" placeholder="@T5V3Web.Content.Persian.EmpTypeName" class="form-control" type="text" name="EmpTypeName" value="" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-center">
                    <label class="control-label">@T5V3Web.Content.Persian.LeaveTypes</label>
                </div>
                <div class="col-sm-10">
                    @foreach (T5V3.Model.LeaveType lt in ViewBag.Leaves)
                    {
                        @Html.Partial("_MaterialCheckbox", new MaterialCheckboxModel() { CheckValue = lt.LeaveTypeID.ToString(), Name = "validLeaveID", ID = (1000+lt.LeaveTypeID), IsChecked = false, Label = lt.LeaveName })
                    }
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <button id="btnEdit" onclick="submitData()" type="button" class="btn btn-success"></button>
                    <button type="button" onclick="invisiblePanel()" class="btn btn-default">@T5V3Web.Content.Persian.Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>


@section modals
{
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 id="msg-title" class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <p id="msg-body"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                </div>
            </div>

        </div>
    </div>
}



@section scripts
{
    <script>
        loadlist(1, "");

        function invisiblePanel() {
            $("#edit-panel").attr("class", "collapsed-visibility panel panel-default");
        }

        function addnew() {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Add2");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Add");

            $("#txtEmpTypeName").val("");
            $("#empTypeID").val(-1);
        }

        function submitData() {
            var leaveIDs = [];
            $('input[name=validLeaveID]:checked').each(function () {
                leaveIDs.push($(this).val());
            });

            var toEdit = { EmpTypeID: $("#empTypeID").val(), EmpTypeName: $("#txtEmpTypeName").val(), validLeaveID: leaveIDs };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(toEdit),
                type: "POST",
                url: "/EmpType/Edit",
                success: function (data) {
                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();
                    if (toEdit.EmpTypeID == -1) {
                        loadlist(-1);
                    }
                    else {
                        loadlist($("body").data("page"), $("body").data("squery"));
                    }
                }
            });
            invisiblePanel();
        }

        function loadItem(id) {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Edit");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Edit");
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                type: "GET",
                url: "/EmpType/GetByID/" + id,
                success: function (data) {
                    $("#txtEmpTypeName").val(data.emp.EmpTypeName);
                    $("#empTypeID").val(data.emp.EmpTypeID);

                    $('input[name=validLeaveID]').each(function () {
                        $(this).prop("checked","");
                    });

                    for (var i = 0; i < data.l.length; i++)
                        $("#chk_" + (1000+data.l[i])).prop("checked", "checked");
                }
            });
        }

    </script>
}





@*model T5V3Web.Models.DataEntryModel<Personnel.Model.EmpType>

    @{
        ViewBag.Title = T5V3Web.Content.Persian.EmpTypes;
        ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.BaseData;
