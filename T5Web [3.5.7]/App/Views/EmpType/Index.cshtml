    @section scripts
    {
        @{
            ViewDataDictionary temp = new ViewDataDictionary();
            temp.Add(new KeyValuePair<string, object>("DeleteUrl", "/EmpType/Delete"));
            temp.Add(new KeyValuePair<string, object>("DeleteAllUrl", "/EmpType/DeleteAll"));
            @Html.Partial("_ConfirmDeleteScripts", temp);
        }
    }*@