@model int
@{
    ViewBag.Title = T5V3Web.Content.Persian.ReportData;
}

<div class="page-header">
    <h3>@T5V3Web.Content.Persian.ReportData (@ViewBag.ReportName )</h3>
</div>

@{
    T5V3Web.Models.GridModel grd = new T5V3Web.Models.GridModel();
    grd.WithParentID = true;
    grd.ParentID = Model;
    grd.DeleteAllAPIPath = "/ReportDatas/DeleteAll";
    grd.DeleteAPIPath = "/ReportDatas/Delete/";
    grd.GetListAPIPath = "/ReportDatas/GetList";
    grd.IDPropertyName = "ReportDataID";
    grd.DisplayPropertyName = "ParameterName";
    grd.Columns.Add(new T5V3Web.Models.GridModel.Column(T5V3Web.Content.Persian.ParameterName, "ParameterName"));
    @Html.Partial("_Grid", grd);
}

<div id="edit-panel" class="panel panel-default collapsed-visibility">
    <div class="panel-heading">
        <label id="title-panel-label">@T5V3Web.Content.Persian.Edit</label>
    </div>
    <div class="panel-body">
        <div class="form-horizontal">

            <input type="hidden" id="reportDataID" />

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.ParameterType <font style="color:red">*</font></label>
                </div>
                <div class="col-sm-10">
                    <select id="cmbParamType" onchange="changeParamType()" class="form-control">
                        <option value="0">@T5V3Web.Content.Persian.T5Parameters</option>
                        <option value="1">@T5V3Web.Content.Persian.LeaveTypes</option>
                        <option value="2">@T5V3Web.Content.Persian.Schedules</option>
                        <option value="3">@T5V3Web.Content.Persian.UserParameters</option>
                        <option value="4">@T5V3Web.Content.Persian.Personnal</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.ParameterName<font style="color:red">*</font></label>
                </div>
                <div class="col-sm-10">
                    <select class="form-control" id="cmbT5">
                        @foreach (KeyValuePair<int, string> param in ViewBag.defaultParams)
                        {
                            <option value="@param.Key">@param.Value</option>
                        }
                    </select>
                    <select class="form-control collapsed-visibility" id="cmbLeaveTypes">
                        @foreach (KeyValuePair<int, string> param in ViewBag.leaveParams)
                        {
                            <option value="@param.Key">@param.Value</option>
                        }
                    </select>
                    <select class="form-control collapsed-visibility" id="cmbSchedules">
                        @foreach (KeyValuePair<int, string> param in ViewBag.schParams)
                        {
                            <option value="@param.Key">@param.Value</option>
                        }
                    </select>
                    <select class="form-control collapsed-visibility" id="cmbUserParams">
                        @foreach (KeyValuePair<int, string> param in ViewBag.userParams)
                        {
                            <option value="@param.Key">@param.Value</option>
                        }
                    </select>
                    <select class="form-control collapsed-visibility" id="cmbPersonnel">
                        @foreach (KeyValuePair<int, string> param in ViewBag.propParams)
                        {
                            <option value="@param.Key">@param.Value</option>
                        }
                    </select>
                </div>

            </div>



            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <button id="btnEdit" onclick="submitData()" type="button" class="btn btn-success"></button>
                    <button type="button" onclick="invisiblePanel()" class="btn btn-default">@T5V3Web.Content.Persian.Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>


@section modals
{
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 id="msg-title" class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <p id="msg-body"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                </div>
            </div>

        </div>
    </div>
}



@section scripts
{
    <script>
        loadlistid(@(Model), 1, "");

        function changeParamType() {
            var i = $('#cmbParamType').val();
            $('#cmbT5').addClass("collapsed-visibility");
            $('#cmbLeaveTypes').addClass("collapsed-visibility");
            $('#cmbSchedules').addClass("collapsed-visibility");
            $('#cmbUserParams').addClass("collapsed-visibility");
            $('#propParams').addClass("collapsed-visibility");

            if (i == 0) {
                $('#cmbT5').removeClass("collapsed-visibility");
            }
            if (i == 1) {
                $('#cmbLeaveTypes').removeClass("collapsed-visibility");
            }
            if (i == 2) {
                $('#cmbSchedules').removeClass("collapsed-visibility");
            }
            if (i == 3) {
                $('#cmbUserParams').removeClass("collapsed-visibility");
            }
            if (i == 4) {
                $('#propParams').removeClass("collapsed-visibility");
            }
        }

        function invisiblePanel() {
            $("#edit-panel").attr("class", "collapsed-visibility panel panel-default");
        }

        function addnew() {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Add2");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Add");

            $("#cmbParamType").val(0);
            $("#reportDataID").val(-1);
        }

        function submitData() {

            var i = $('#cmbParamType').val();
            var paramID = 0;
            if (i == 0) {
                paramID = $('#cmbT5').val();
            }
            if (i == 1) {
                paramID = $('#cmbLeaveTypes').val();
            }
            if (i == 2) {
                paramID = $('#cmbSchedules').val();
            }
            if (i == 3) {
                paramID = $('#cmbUserParams').val();
            }
            if (i == 4) {
                paramID = $('#propParams').val();
            }

            var toEdit = {
                ReportDataID: $("#reportDataID").val(),
                ReportID: @Model,
                ParameterID: paramID,
                ParameterType: $("#cmbParamType").val()
            };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(toEdit),
                type: "POST",
                url: "/ReportDatas/Edit",
                success: function (data) {
                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();
                    if (toEdit.ReportDataID == -1) {
                        loadlistid(@(Model), -1, "");
                    }
                    else {
                        loadlistid(@(Model),$("body").data("page"), $("body").data("squery"));
                    }
                }
            });
            invisiblePanel();
        }

        function loadItem(id) {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Edit");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Edit");
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                type: "GET",
                url: "/ReportDatas/GetByID/" + id,
                success: function (data) {
                    $("#cmbParamType").val(data.ParameterType);
                    var i = data.ParameterType;
                    if (i == 0) {
                        $('#cmbT5').val(data.ParameterID);
                    }
                    if (i == 1) {
                        $('#cmbLeaveTypes').val(data.ParameterID);
                    }
                    if (i == 2) {
                        $('#cmbSchedules').val(data.ParameterID);
                    }
                    if (i == 3) {
                        $('#cmbUserParams').val(data.ParameterID);
                    }
                    if (i == 4) {
                        $('#propParams').val(data.ParameterID);
                    }
                    changeParamType();
                    $("#reportDataID").val(data.ReportDataID);
                }
            });
        }

    </script>
}