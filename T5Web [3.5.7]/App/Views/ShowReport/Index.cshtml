@model T5V3Web.Models.CustomReportModel
@{
    ViewBag.Title = T5V3Web.Content.Persian.ShowReport;
}

<h3>@T5V3Web.Content.Persian.ShowReport</h3>
<div class="horizontal-line"></div>

<form method="post" action="/ShowReport/Show">

    <div class="panel panel-default">
        <div class="panel-heading">
            <label>@T5V3Web.Content.Persian.SelectPersonnel ...</label>
        </div>
        <div class="panel-body">
            @Html.Partial("_SelectUser", T5V3Web.Controllers.UserSelectionController.CreateModel(Model.BadgeNumbers))
        </div>
    </div>


    <div class="panel panel-default">
        <div class="panel-heading">
            <label>@T5V3Web.Content.Persian.SelectTimeInterval ...</label>
        </div>
        <div class="panel-body">
            @Html.Partial("_SelectDateInterval", Model.Interval)
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-2">
            <label>@T5V3Web.Content.Persian.ReportName</label>
        </div>
        <div class="col-sm-10">
            <select class="form-control" name="reportID">
                @foreach (T5V3.Model.Reportmdl rep in ViewBag.Reports)
                {
                    <option value="@rep.ReportID">
                        @rep.ReportName
                    </option>
                }
            </select>
        </div>
    </div>
    <input class="btn btn-default mt-20 mb-20" value="@T5V3Web.Content.Persian.Show" type="submit" />

    <div class="form-group">
        <div class="col-sm-10 col-sm-offset-1 center-align">
            @if (Model.ValidationMessage != null)
            {
                <div class="@((T5V3Web.Models.ValidationMessageType)Model.ValidationMessageType == T5V3Web.Models.ValidationMessageType.Error ? "alert alert-danger fade in" : "alert alert-success fade in")">
                    @Model.ValidationMessage
                    <a  rel="noopener noreferrer" href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                </div>
            }
        </div>
    </div>

</form>

<div class="horizontal-line mt-20"></div>



<input id="reportParams" type="hidden" value="@Model.ForQueryString()" />
<input id="reportPage" type="hidden" value="1" />
<iframe id="ifReport" class="block-display w-100p" style="height:1000px" src="/ShowReport/DReport?@(Model.ForQueryString())"></iframe>
<div class="horizontal-line"></div>



<script>
    function nextPage() {
        var pageNumber = document.getElementById("reportPage").value;
        pageNumber++;
        document.getElementById("ifReport").src = "/ShowReport/DReport?" + document.getElementById("reportParams").value + "&page=" + pageNumber;
        document.getElementById("reportPage").value = pageNumber;
    }

    function prevPage() {
        var pageNumber = document.getElementById("reportPage").value;
        pageNumber--;
        document.getElementById("ifReport").src = "/ShowReport/DReport?" + document.getElementById("reportParams").value + "&page=" + pageNumber;
        document.getElementById("reportPage").value = pageNumber;
    }
</script>