@model AddShiftModel
@{
    ViewBag.Title = T5V3Web.Content.Persian.UserShifts;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.AttendanceData;
    ViewBag.PageTag = "AssignShift";
}

<div class="text-right card-header">
    <h3>@T5V3Web.Content.Persian.SelectShift</h3>
</div>

<div class="card">
    <form role="form" class="form-horizontal" method="post" action="/AssignShift/AddShift">
        @foreach (long l in Model.SelectedBadgeNumbers)
        {
            <input type="hidden" value="@l" name="selectedBadgeNumbers" />
        }



        <div class="row">
            <div class="col-sm-offset-1 ">
                <div class="col-sm-6">
                    @{

                        List<KeyValuePair<string, string>> shiftNames = new List<KeyValuePair<string, string>>();

                    }
                    @foreach (T5V3.Model.Shift s in ViewBag.Shifts)
                    {
                        shiftNames.Add(new KeyValuePair<string, string>(s.ShiftID.ToString(), s.ShiftName));
                        //if (Model.isEdit && (s.ShiftID == Model.ShiftID))
                        {
                        }
                        //else
                        {
                        }
                    }
                    @Html.Partial("_MaterialDropdown", new MaterialDropdownParameters()
                        {
                            Header = Persian.ShiftName,
                            InputID = "cmbShift",
                            InputName = "shiftID",
                            ChangeMethod = "dropdownChanged",
                            TextboxID = "txtShiftName",
                            Values = shiftNames
                        }
                    )

                    @*<div class="form-group">
                            <div class="col-sm-2">
                                <label class="control-label">@T5V3Web.Content.Persian.ShiftName</label>
                            </div>
                            <div class="col-sm-10">
                                <select name="shiftID" class="form-control">

                                </select>
                            </div>
                        </div>*@


                    @Html.Partial("_MaterialDateInput", new T5V3Web.Models.MaterialDateInputModel() { Label = Persian.FromDate, Name = "FromDateHijri", OldValue = Model.isEdit ? Model.FromDate : T5V3.Misc.DateConverter.ToHijriDate(DateTime.Now) })
                    @Html.Partial("_MaterialDateInput", new T5V3Web.Models.MaterialDateInputModel() { Label = Persian.ToDate, Name = "ToDateHijri", OldValue = Model.isEdit ? Model.ToDate : T5V3.Misc.DateConverter.ToHijriDate(DateTime.Now.AddYears(2)) })

                </div>
            </div>
        </div>
       
        @*<div class="col-sm-8">
                <div class="col-sm-2">
                    <label class="control-label">@T5V3Web.Content.Persian.FromDate</label>
                </div>
                <div class="col-sm-8">
                    <input class="form-control" name="FromDateHijri" type="text" value="@(Model.isEdit ? Model.FromDate : T5V3.Misc.DateConverter.ToHijriDate(DateTime.Now))" />
                </div>
                <div class="col-sm-2 text-right">
                    <a href="javascript:" onclick="displayDatePicker('FromDateHijri', this)">@T5V3Web.Content.Persian.Select</a>
                </div>
            </div>*@


        @*<div class="form-group">
                <div class="col-sm-2">
                    <label class="control-label">@T5V3Web.Content.Persian.ToDate</label>
                </div>
                <div class="col-sm-8">
                    <input class="form-control" name="ToDateHijri" type="text" value="@(Model.isEdit ? Model.ToDate : T5V3.Misc.DateConverter.ToHijriDate(DateTime.Now.AddYears(2)))" />
                </div>
                <div class="col-sm-2 text-right">
                    <a href="javascript:" onclick="displayDatePicker('ToDateHijri', this)">@T5V3Web.Content.Persian.Select</a>
                </div>
            </div>*@
        <input type="hidden" name="isEdit" value="@Model.isEdit.ToString()" />
        @*@if (Model.isEdit)
            {*@
        <input type="hidden" name="editShiftID" value="@Model.ShiftID.ToString()" />
        <input type="hidden" name="editFrom" value="@Model.FromDate" />

        <div class="form-group">
            <input type="submit" class="btn btn-primary btn-shadow" value="@T5V3Web.Content.Persian.OK" name="action" />
            <input type="submit" class="btn btn-default" value="@T5V3Web.Content.Persian.Cancel" name="action" />
        </div>
    </form>
</div>
@section scripts
{

    <script src="~/Scripts/index.js"></script>
    <script>

        settings = {
            format: "yyyy/mm/dd",
            dateSeparator: "/",
            autoClose: true,
            labelLanguage: 'farsi'
        }
        renderToday();
    </script>
}