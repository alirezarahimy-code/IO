@{
    ViewBag.Title = T5V3Web.Content.Persian.CustomWorkflow;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.BaseData;
    ViewBag.PageTag = "CustomWF";
}

<div class="page-header">
    <h3>@T5V3Web.Content.Persian.CustomWorkflow</h3>
</div>

@{
    T5V3Web.Models.GridModel grd = new T5V3Web.Models.GridModel();
    grd.DeleteAllAPIPath = "/CustomWF/DeleteAll";
    grd.DeleteAPIPath = "/CustomWF/Delete/";
    grd.GetListAPIPath = "/CustomWF/GetList";
    grd.IDPropertyName = "CustomWorkflowID";
    grd.DisplayPropertyName = "Label";
    grd.Columns.Add(new T5V3Web.Models.GridModel.Column(T5V3Web.Content.Persian.CustomWorkflow, "Label"));
    @Html.Partial("_Grid", grd);
}

<div id="edit-panel" class="panel panel-default collapsed-visibility">
    <div class="panel-heading">
        <label id="title-panel-label">@T5V3Web.Content.Persian.Edit</label>
    </div>
    <div class="panel-body">
        <div class="form-horizontal">

            <input type="hidden" id="certID" />
            <div class="form-group">
                <div class="col-sm-2 text-center">
                    <label class="control-label">@T5V3Web.Content.Persian.CertificateName <font style="color:red">*</font></label>
                </div>
                <div class="col-sm-10">
                    <input id="txtCertificateName" placeholder="@T5V3Web.Content.Persian.CertificateName" class="form-control" type="text" name="CertificateName" value="" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <button id="btnEdit" onclick="submitData()" type="button" class="btn btn-success"></button>
                    <button type="button" onclick="invisiblePanel()" class="btn btn-default">@T5V3Web.Content.Persian.Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section modals
{
    <div id="formModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@T5V3Web.Content.Persian.CustomWorkflow</h4>
                </div>
                <div class="modal-body">

                    <form id="frmData">
                        <div class="form-horizontal">

                            <input type="hidden" id="CustomWorkflowID" name="CustomWorkflowID" />
                            <div class="form-group">
                                <div class="col-sm-2 text-center">
                                    <label class="control-label">@T5V3Web.Content.Persian.Name <font style="color:red">*</font></label>
                                </div>
                                <div class="col-sm-10">
                                    <input id="txtLabel" placeholder="@T5V3Web.Content.Persian.Name" class="form-control" type="text" name="Label" value="" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-sm-2 text-center">
                                    <label class="control-label">@T5V3Web.Content.Persian.LeaveType</label>
                                </div>
                                <div class="col-sm-10">
                                    <select id="cmbLeaveTypeID" name="LeaveTypeID" class="form-control">
                                        <option value="-1">@T5V3Web.Content.Persian.All</option>
                                        @foreach (T5V3.Model.LeaveType lt in ViewBag.LeaveTypes)
                                        {
                                            <option value="@lt.LeaveTypeID">@lt.LeaveName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-sm-2 text-center">
                                    <label class="control-label">@T5V3Web.Content.Persian.MinValue</label>
                                </div>
                                <div class="col-sm-10">
                                    <input id="txtMinRequestLen" placeholder="@T5V3Web.Content.Persian.MinValue" class="form-control" type="text" name="MinRequestLen" value="" />
                                </div>
                            </div>


                            <div class="form-group">
                                <div class="col-sm-2 text-center">
                                    <label class="control-label">@T5V3Web.Content.Persian.MaxValue</label>
                                </div>
                                <div class="col-sm-10">
                                    <input id="txtMaxRequestLen" placeholder="@T5V3Web.Content.Persian.MaxValue" class="form-control" type="text" name="MaxRequestLen" value="" />
                                </div>
                            </div>


                            <div class="form-group">
                                <div class="col-sm-2 text-center">
                                    <label class="control-label">@T5V3Web.Content.Persian.LeaveDescription</label>
                                </div>
                                <div class="col-sm-10">
                                    <select id="cmbLeaveDescriptionID" name="LeaveDescriptionID" class="form-control">
                                        <option value="-1">@T5V3Web.Content.Persian.All</option>
                                        @foreach (T5V3.Model.LeaveDescription lt in ViewBag.LeaveDescriptions)
                                        {
                                            <option value="@lt.ID">@lt.Description</option>
                                        }
                                    </select>
                                </div>
                            </div>


                            <div class="form-group">
                                <div class="col-sm-2 text-center">
                                    <label class="control-label">@T5V3Web.Content.Persian.DescriptionsContains</label>
                            </div>
                            <div class="col-sm-10">
                                <input id="txtDescriptionsStartWith" class="form-control" type="text" name="DescriptionsStartWith" value="" />
                            </div>
                        </div>



                        <div class="form-group">
                            <div class="col-sm-2 text-center">
                                <label class="control-label">@T5V3Web.Content.Persian.DescriptionsStartsWith</label>
                            </div>
                            <div class="col-sm-10">
                                <input id="txtDescriptionsContains" class="form-control" type="text" name="DescriptionsContains" value="" />
                            </div>
                        </div>

                    </div>
                </form>

                </div>
                <div class="modal-footer">
                    <button type="button" onclick="submitData()" class="btn btn-success" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.Cancel</button>
                </div>
            </div>

        </div>
    </div>



    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 id="msg-title" class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <p id="msg-body"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                </div>
            </div>

        </div>
    </div>
}


@section scripts
{
    <script>
        loadlist(1, "");

        function invisiblePanel() {
            $("#edit-panel").attr("class", "collapsed-visibility panel panel-default");
        }

        function addnew() {
            $("#CustomWorkflowID").val(-1);
            $("#txtLabel").val("");
            $("#cmbLeaveTypeID").val(-1);
            $("#txtMinRequestLen").val("");
            $("#txtMaxRequestLen").val("");
            $("#cmbLeaveDescriptionID").val(-1);
            $("#txtDescriptionsStartWith").val("");
            $("#txtDescriptionsContains").val("");

            $("#formModal").modal();
        }

        function submitData() {
            var toEdit = $('#frmData').serialize();
            $.ajax({
                contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                data:toEdit,
                type: "POST",
                url: "/CustomWF/Edit",
                success: function (data) {
                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();
                    if (toEdit.CertificateID == -1) {
                        loadlist(-1);
                    }
                    else {
                        loadlist($("body").data("page"), $("body").data("squery"));
                    }
                }
            });
            invisiblePanel();
        }

        function loadItem(id) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                type: "GET",
                url: "/CustomWF/GetByID/" + id,
                success: function (data) {
                    $("#CustomWorkflowID").val(data.CustomWorkflowID);
                    $("#txtLabel").val(data.Label);
                    $("#cmbLeaveTypeID").val(data.LeaveTypeID);
                    $("#txtMinRequestLen").val(data.MinRequestLen);
                    $("#txtMaxRequestLen").val(data.MaxRequestLen);
                    $("#cmbLeaveDescriptionID").val(data.LeaveDescriptionID);
                    $("#txtDescriptionsStartWith").val(data.DescriptionsStartWith);
                    $("#txtDescriptionsContains").val(data.DescriptionsContains);

                    $("#formModal").modal();
                }
            });
        }

    </script>
}