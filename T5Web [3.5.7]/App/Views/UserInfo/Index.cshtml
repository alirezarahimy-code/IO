        <script>

        $('#SectionFilter').click(function ()
        {
            var val = $('#SectionFilterStr').val();
            $.get("/UserInfo/GetDeptsTreeFiltered?deptID=" + "@Model.Selected.DeptID" + "&searchStr=" + val, "", (function (gdata) {
                $('#tree').empty();
                $('#tree').treeview({
                    data: gdata,
                    levels: 50,
                    enableLinks: false,
                    onNodeSelected: function (event, data) {
                        $("#lblDept").html(data.text);
                        $("#linkToAddNew").attr("href", "/UserInfo?deptID=" + data.tags);

                        loadDeptPersonnel(data.tags);
                    }
                });
            }));
            $.get("/UserInfo/GetUploadDevicesTree?badgeNumber=" + "@Model.Selected.BadgeNumber", "", (function (gdata) {
                $('#treeUploadDevices').treeview({
                    data: gdata,
                    levels: 50,
                    showCheckbox: true
                });
            }));
            $.get("/UserInfo/GetValidDevicesTree?badgeNumber=" + "@Model.Selected.BadgeNumber", "", (function (gdata) {
                $('#treeValidDevices').treeview({
                    data: gdata,
                    levels: 50,
                    showCheckbox: true
                });
            }));

            });

        $("#titleToAdd").selectpicker();
        $.get("/UserInfo/GetDeptsTree?deptID=" + "@Model.Selected.DeptID", "", (function (gdata) {
            $('#tree').treeview({
                data: gdata,
                levels: 50,
                enableLinks: false,
                onNodeSelected: function (event, data) {
                    $("#lblDept").html(data.text);
                    $("#linkToAddNew").attr("href", "/UserInfo?deptID=" + data.tags);

                    loadDeptPersonnel(data.tags);
                }
            });
        }));
        $.get("/UserInfo/GetUploadDevicesTree?badgeNumber=" + "@Model.Selected.BadgeNumber", "", (function (gdata) {
            $('#treeUploadDevices').treeview({
                data: gdata,
                levels: 50,
                showCheckbox: true
            });
        }));
        $.get("/UserInfo/GetValidDevicesTree?badgeNumber=" + "@Model.Selected.BadgeNumber", "", (function (gdata) {
            $('#treeValidDevices').treeview({
                data: gdata,
                levels: 50,
                showCheckbox: true
            });
        }));

        function addNewUser(deptID) {

            $("#msg-title-transfer").html("@(Persian.AddNewPersonnel)");
            $("input[name=deptID]").val(deptID);
            $("#txtBadge").val("");
            $("input#badgeToAdd").val("-1");
            $("input[name=employeeNumber]").val("");
            $("input[name=firstName]").val("");
            $("input[name=lastName]").val("");
            $("input[name=fatherName]").val("");
            $("input[name=nationalNumber]").val("");
            $("input[name=tel]").val("");
            $("input[name=email]").val("");
            $("input[name=address]").val("");
            $("input[name=gender],[value=true]").prop("checked", false);
            $("input[name=gender],[value=false]").prop("checked", true);
            $("input[name=birthday]").val("");
            $("input[name=hiredDay]").val("");
            $("input[name=firedDay]").val("");
            //$("#titleTo").prop("checked", true);
            $("#datePickerFiredDate").addClass("collapsed-visibility");
            $("input[name=userNameEdit]").val("");
            $("input[name=passwordEdit]").val("");
            $('input[name="userNameEdt"]').val('');
            $('input[name="passwordEdt"]').val('');

            $("input[name=deviceName]").val("");
            $("input[name=devicePassword]").val("");
            $("select[name=devicePrivilage]").val("0");
            $("input[name=deviceCardNumber]").val("");
            $("input[name=deviceGroupNumber]").val("1");
            $("input[name=deviceEnable],[value=true]").prop("checked", true);
            $("input[name = titleTo]").attr("disabled", "disabled");
            $("#titleToDateDatePicker").addClass("collapsed-visibility");
            $("input[name = titleTo]").val("");
            $("input[name=webUser]").prop("checked", true);
            $("input[name=programUser]").prop("checked", false);

            $("input[name=isAdd]").val("true");
            $("#titlesdiv").html("");

            $("#userinfoModal").modal();
        }


        function addUser() {
            run_waitMe('win8');

            $.ajax({
                contentType: "application/x-www-form-urlencoded; charset=utf-8",
                data: $("#frmDetails").serialize(),
                type: "POST",
                url: "/UserInfo/Edit",
                success: function(data) {
                    $('body').waitMe('hide');
                    alert(data.message);
                    window.location.href = "/UserInfo/index";
                    loadDeptPersonnel($("input[name=deptID]").val());
                }
        });
        }

        function editUser(badgeNumber) {
            var postData = { badgeNumber: badgeNumber };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(postData),
                type: "POST",
                url: "/UserInfo/GetPersonnelByID",
                success: function (data) {
                    console.log(data);
                    $("input[name = titleTo]").attr("disabled", "disabled");
                    $("#titleToDateDatePicker").addClass("collapsed-visibility");

                    $("input[name=isAdd]").val("false");

                    $("#txtBadge").val(data.info.BadgeNumber);

                    $("input[name=badge]").val(data.info.BadgeNumber);
                    $("input#badgeToAdd").val(data.info.BadgeNumber);
                    $("input[name=deptID]").val(data.info.DeptID);

                    $("input[name=employeeNumber]").val(data.info.EmployeeNumber);
                    $("input[name=firstName]").val(data.info.FirstName);
                    $("input[name=lastName]").val(data.info.LastName);
                    $("input[name=fatherName]").val(data.info.FatherName);
                    $("input[name=nationalNumber]").val(data.info.NationalNumber);
                    $("input[name=tel]").val(data.info.Tel);
                    $("input[name=email]").val(data.info.Email);
                    $("input[name=address]").val(data.info.Address);
                    if (data.info.IsFemale) {
                        $("input[name=gender],[value=true]").prop("checked", true);
                        $("input[name=gender],[value=false]").prop("checked", false);
                    }
                    else {
                        $("input[name=gender],[value=true]").prop("checked", false);
                        $("input[name=gender],[value=false]").prop("checked", true);
                    }

                    $('input[name="userNameEdt"]').val(data.info.UserName);
                    $('input[name="passwordEdt"]').val(data.info.Password);


                    $("input[name=validFrom]").prop("checked", data.info.ValidFromHasValue);
                    $("input[name=validTo]").prop("checked", data.info.ValidToHasValue);
                    $("input[name=validFromDate]").val(data.info.ValidFromHijriDateOnly);
                    $("input[name=validToDate]").val(data.info.ValidToHijriDateOnly);
                    $("input[name=validFromTime]").val(data.info.ValidFromTimeOnly);
                    $("input[name=validToTime]").val(data.info.ValidToTimeOnly);

                    $("input[name=deviceName]").val(data.info.DeviceName);

                    $("input[name=webUser]").prop("checked", data.info.WebUser);
                    $("input[name=programUser]").prop("checked", data.info.ProgramUser);
                    $("input[name=birthday]").val(data.info.HijriBirthDay);
                    $("input[name=hiredDay]").val(data.info.HijriHireDay);
                    if (data.info.FiredDay != null) {
                        $("input[name=endWork]").prop("checked", true);
                        $("#txtFiredDate").removeAttr("disabled");
                        $("#datePickerFiredDate").removeClass("collapsed-visibility");
                        $("input[name=firedDay]").val(data.info.HijriFiredDay);
                    }
                    else {
                        $("input[name=endWork]").prop("checked",false);
                        $("#txtFiredDate").attr("disabled", "disabled");
                        $("#datePickerFiredDate").addClass("collapsed-visibility");
                        $("input[name=firedDay]").val("");
                    }
                    if (data.info.ValidFrom != null) {
                        $("input[name=validFrom]").prop("checked", true);
                        $("input[name = validFromDate]").removeAttr("disabled");
                        $("input[name = validFromTime]").removeAttr("disabled");
                        $("input[name = validFromDate]").val(data.info.ValidFromHijriDateOnly);
                        $("input[name = validFromTime]").val(data.info.ValidFromTimeOnly);
                    }
                    else {
                        $("input[name = validFromDate]").attr("disabled", "disabled");
                        $("input[name = validFromDate]").val("");
                        $("input[name = validFromTime]").attr("disabled", "disabled");
                        $("input[name = validFromTime]").val("");

                    }
                    if (data.info.ValidTo != null) {
                        $("input[name=validTo]").prop("checked", true);
                        $("input[name = validToDate]").removeAttr("disabled");
                        $("input[name = validToTime]").removeAttr("disabled");
                        $("input[name = validToDate]").val(data.info.ValidToHijriDateOnly);
                        $("input[name = validToTime]").val(data.info.ValidToTimeOnly);
                    }
                    else {
                        $("input[name = validToDate]").attr("disabled", "disabled");
                        $("input[name = validToDate]").val("");
                        $("input[name = validToTime]").attr("disabled", "disabled");
                        $("input[name = validToTime]").val("");

                    }

                    $("select[name=certificateID]").val(data.info.CertificateID);
                    $("select[name=empTypeID]").val(data.info.EmpTypeID);
                    $("select[name=janbazCode]").val(data.info.JanbazCode);


                    $("#titlesdiv").html("");
                    for (var i = 0; i < data.titles.length; i++) {
                        insertTitleToGrid(data.titles[i].TitleID, data.titles[i].BadgeNumber, data.titles[i].FromDateHijri, data.titles[i].ToDateHijri, (data.titles[i].ToDate != null), data.titles[i].TitleName);
                    }



                    $("#msg-title-transfer").html("@(Persian.EditPersonnel)");

                    $("#userinfoModal").modal();

                }
            });
        }

        function hideDetailsSection() {
            $("#detailsSection").addClass("collapsed-visibility");
        }

        function searchPersonnel() {
            var postData = { query: $("#txtSearchPersonnel").val() };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(postData),
                type: "POST",
                url: "/UserInfo/SearchPersonnel",
                success: function (data) {
                    addPersonnelToTable(data);
                }
            });
        }

        function loadDeptPersonnel(deptID) {
            var postData = { deptID: deptID };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(postData),
                type: "POST",
                url: "/UserInfo/GetPersonnel",
                success: function (data) {
                    addPersonnelToTable(data);
                    checkStateChanges();
                }
            });
        }


        function acceptTransfer() {
            var ids = [];
            var checkedList = $("#tblBody input[type=\"checkbox\"]:checked");
            for (var i = 0; i < checkedList.length ; i++)
                ids.push(checkedList[i].value);

            var toNode;
            toNode = $('#transferTree').treeview(true).getSelected();
            var deptID = toNode[0].tags;

            var postData = {
                BadgeNumbers: ids,
                deptID: deptID
            };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(postData),
                type: "POST",
                url: "/UserInfo/Tranfer",
                success: function (data) {

                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();

                    var nodeId;
                    nodeId = $('#tree').treeview(true).getSelected();
                    loadDeptPersonnel(nodeId[0].tags)
                }
            });
        }

        function transfer() {
            $("#lblTransferDept").html("");
            $("#deptModal").modal();

            $.get("/UserInfo/GetDeptsTree?deptID=" + "@Model.Selected.DeptID", "", (function (gdata) {
                $('#transferTree').treeview({
                    data: gdata,
                    levels: 50,
                    enableLinks: false,
                    onNodeSelected: function (event, data) {
                        $("#lblTransferDept").html(data.text);
                    }
                });
            }));
        }

        function endWork() {
            var ids = [];
            var checkedList = $("#tblBody input[type=\"checkbox\"]:checked");
            for (var i = 0; i < checkedList.length ; i++)
                ids.push(checkedList[i].value);

            var postData = { BadgeNumbers: ids };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(postData),
                type: "POST",
                url: "/UserInfo/EndWork",
                success: function (data) {

                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();

                    var nodeId;
                    nodeId = $('#tree').treeview(true).getSelected();
                    loadDeptPersonnel(nodeId[0].tags);
                }
            });


        }

        function addPersonnelToTable(data) {

            $("#tblBody").html("");
            for (var i = 0; i < data.length; i++) {
                var trElement = $("<tr><td class=\"text-center\"><input onclick=\"checkStateChanges()\" class=\"ml-5\" type=\"checkbox\" name=\"ids\" data-toggle=\"tooltip\" title=\"\" value=\"" + data[i].BadgeNumber
                    + "\"><a  rel='noopener noreferrer' onclick=\"confirmDelete(" + data[i].BadgeNumber + ")\" data-toggle=\"tooltip\" href=\"javascript:void(0)\" title=\""
                    + data[i].Name + "\"><span class=\"glyphicon glyphicon-remove\"></span></a><a  rel='noopener noreferrer' data-toggle=\"tooltip\"  title=\"" + data[i].Name
                    + "\" href=\"javascript:editUser(" + data[i].BadgeNumber + ")\"><span class=\"glyphicon glyphicon-edit\"></span></a></td><td><label>"
                    + data[i].BadgeNumber + "</label></td><td><label>" + data[i].Name + "</label></td><td><label>" + data[i].DeptName + "</label></td></tr>");
                trElement.appendTo($("#tblBody"));
            }
        }

        function checkStateChanges() {
            var count = $("#tblBody input[type=\"checkbox\"]:checked").length;
            if (count > 0) {
                $('#btnEndWork').removeAttr("disabled");
                $('#btnTransfer').removeAttr("disabled");
            }
            else {
                $('#btnEndWork').attr("disabled", "disabled");
                $('#btnTransfer').attr("disabled", "disabled");
            }
        }

        function getSelectedText(elementId) {
            var elt = document.getElementById(elementId);

            if (elt.selectedIndex == -1)
                return null;

            return elt.options[elt.selectedIndex].text;
        }

        function addTitle() {
            var tID = document.getElementById('titleToAdd').value;
            var badge = document.getElementById('badgeToAdd').value;
            var frDate = document.getElementById('titleFromDate').value;
            var tDate = document.getElementById('titleToDate').value;
            var titleTo = document.getElementById('titleTo').checked;

            insertTitleToGrid(tID, badge, frDate, tDate, titleTo, getSelectedText('titleToAdd'))
        }

        function insertTitleToGrid(tID, badge, frDate, tDate, titleTo, tName) {
            if (frDate.trim() == "") {
                $("#msg-title").html("@(T5V3Web.Content.Persian.Title)");
                $("#msg-body").html("@(T5V3Web.Content.Persian.InputStaredItems)");
                $("#myModal").modal();
                return;
            }

            var hidVal = badge + ';' + tID + ';' + frDate + ';';
            if (titleTo == true)
                hidVal += tDate;
            else
                hidVal += '-';


            var div = document.createElement('tr');
            var td0 = document.createElement('td');

            var delLink = document.createElement('a');
            delLink.href = 'javascript:';
            delLink.setAttribute('onclick', 'deleteRow(this)');
            delLink.innerHTML = '<img class="vertical-middle" src="/Images/remove-icon24.png" />';
            td0.appendChild(delLink);

            var td1 = document.createElement('td');
            var td2 = document.createElement('td');
            var td3 = document.createElement('td');

            var l1 = document.createElement('label');
            l1.innerHTML = tName;
            l1.className = 'inline-block-display w-240';
            td1.appendChild(l1);

            var l2 = document.createElement('label');
            l2.innerHTML = frDate;
            td2.appendChild(l2);

            var l3 = document.createElement('label');
            if (titleTo == true)
                l3.innerHTML += tDate;
            else
                l3.innerHTML += '-';
            td3.appendChild(l3);

            var hi = document.createElement('input');
            hi.value = hidVal;
            hi.type = 'hidden';
            hi.name = 'ownedTitles';
            td0.appendChild(hi);

            div.appendChild(td0);
            div.appendChild(td1);
            div.appendChild(td2);
            div.appendChild(td3);

            document.getElementById('titlesdiv').appendChild(div);
        }

        function deleteRow(ele) {
            document.getElementById('titlesdiv').removeChild(ele.parentNode.parentNode);
        }

        function readURL(evt) {
            var tgt = evt;//.target;// || window.event.srcElement;
            var files = tgt.files;

            if (FileReader && files && files.length) {
                var fr = new FileReader();
                fr.onload = function () {
                    document.getElementById('blah').src = fr.result;
                }
                fr.readAsDataURL(files[0]);
            }
        }

