@model T5V3Web.Models.DataEntryModel<Personnel.Model.UserInfo>
    @{
        ViewBag.Title = T5V3Web.Content.Persian.Personnel;
        ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.BaseData;
        ViewBag.PageTag = "UserInfo";
    }



    <div class="card-header text-right">
        <h3>@T5V3Web.Content.Persian.Personnel</h3>
    </div>

    <div class="card">
        <div class="row mb-20">
            <div class="col-sm-4">
                <div class="panel panel-default text-right">
                    <div class="panel-heading">
                        <label>@T5V3Web.Content.Persian.Department : </label>
                        <label id="lblDept">@Model.Selected.DeptName</label>
                        <a rel="noopener noreferrer" id="linkToAddNew" href="javascript:addNewUser(@Model.Selected.DeptID)">(@T5V3Web.Content.Persian.AddNewPersonnel)</a>
                    </div>
                    <div class="panel-body">
                        <div class="auto-scroll h-200">
                            <div id="tree">

                            </div>
                        </div>
                    </div>
                    <div class="panel-body">
                        <input type="text" id="SectionFilterStr" class="form-control col-md-8" value="" />
                        <button id="SectionFilter" type="button" class="form-control col-md-4">فیلتر قسمت ها</button>
                    </div>
                </div>
            </div>

            <div class="col-sm-8">
                <div class="panel panel-default text-right">
                    <div class="panel-heading">
                        <div>
                            <input id="txtSearchPersonnel" onkeyup="searchPersonnel()" placeholder="@T5V3Web.Content.Persian.SearchPersonnel" type="text" name="q" />
                            <button onclick="searchPersonnel()" class="btn btn-default">@T5V3Web.Content.Persian.Search</button>
                        </div>
                    </div>

                    <div class="panel-body ">
                        <div style="max-height:300px" class="h-200 auto-scroll">
                            <table class="table table-striped table-responsive table-hover table-bordered">
                                <thead>
                                    <tr class="warning">
                                        <td>@T5V3Web.Content.Persian.SelectDeleteEdit</td>
                                        <td>@T5V3Web.Content.Persian.BadgeNumber</td>
                                        <td>@T5V3Web.Content.Persian.FirstName</td>
                                        <td>@T5V3Web.Content.Persian.Department</td>
                                    </tr>
                                </thead>
                                <tbody id="tblBody">
                                    @{
                                        foreach (Personnel.Model.UserInfo c in Model.ItemsList)
                                        {
                                            <tr>
                                                <td class="text-center">
                                                    <input type="checkbox" onclick="checkStateChanges()" value="@c.BadgeNumber" />
                                                    <a rel="noopener noreferrer" onclick="confirmDelete(@c.BadgeNumber)" data-toggle="tooltip" class="vertical-middle" href="javascript:void(0)" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Delete, c.ToString()))">
                                                        <span class="glyphicon glyphicon-remove"></span>
                                                    </a>
                                                    <a rel="noopener noreferrer" data-toggle="tooltip" class="vertical-middle" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Edit, c.ToString()))" href="javascript:editUser(@c.BadgeNumber)">
                                                        @*href="/UserInfo?deptId=@c.DeptID&badgeNumber=@c.BadgeNumber">*@
                                                        <span class="glyphicon glyphicon-edit"></span>
                                                    </a>
                                                </td>
                                                <td>
                                                    <label class="vertical-middle">@c.BadgeNumber</label>
                                                </td>
                                                <td>
                                                    <label class="vertical-middle">@c.ToString()</label>
                                                </td>
                                                <td>
                                                    <label class="vertical-middle">@c.DeptName</label>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="panel panel-danger clear-fix">
            <div class="panel-heading">
                <button id="btnEndWork" onclick="endWork()" disabled class="btn btn-default btn-sm" title="@T5V3Web.Content.Persian.EndWork">
                    <span class="glyphicon glyphicon-log-out"></span>
                </button>
                <button id="btnTransfer" onclick="transfer()" disabled class="btn btn-default btn-sm" title="@T5V3Web.Content.Persian.Transfer">
                    <span class="glyphicon glyphicon-transfer"></span>
                </button>
            </div>
        </div>


    </div>


    @section modals
{
        <div id="userinfoModal" class="modal fade" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 id="msg-title-transfer" class="modal-title">@T5V3Web.Content.Persian.Edit</h4>
                    </div>
                    <form method="post" id="frmDetails" class="form-horizontal" role="form" autocomplete="off" action="/UserInfo/Edit" enctype="multipart/form-data">
                        <input type="hidden" name="isAdd" value="false" />
                        <div class="modal-body text-right">

                            <div id="detailsSection">
                                @*class="@(((Model.Selected.BadgeNumber > 0)||  (ViewBag.IsNew)) ? "" : "collapsed-visibility")">*@
                                <div class="row pad-5">
                                    <div id="tabs" style="font-family:Tahoma">
                                        <ul id="temp">
                                            <li><a rel="noopener noreferrer" href="#tabs-1">@T5V3Web.Content.Persian.BaseDate</a></li>
                                            <li><a rel="noopener noreferrer" href="#tabs-2">@T5V3Web.Content.Persian.Details</a></li>
                                            <li><a rel="noopener noreferrer" href="#tabs-3">@T5V3Web.Content.Persian.Access</a></li>
                                            <li><a rel="noopener noreferrer" href="#tabs-4">@T5V3Web.Content.Persian.Device</a></li>
                                            <li><a rel="noopener noreferrer" href="#tabs-5">@T5V3Web.Content.Persian.Titles</a></li>
                                        </ul>
                                        <div id="tabs-1">
                                            <div style="display:table">

                                                <div class="col-sm-6">
                                                    <div class="form-group">
                                                        <div class="text-center col-sm-3">
                                                            <label class="control-label">@T5V3Web.Content.Persian.BadgeNumber</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            @*@if (@Model.Selected.BadgeNumber > 0)
                                                                {
                                                                    <input disabled="disabled" id="txtBadge" class="form-control" type="text" value="@Model.Selected.BadgeNumber.ToString()" />
                                                                    <input type="hidden" name="badgeNumber" value="@Model.Selected.BadgeNumber.ToString()" />
                                                                }
                                                                else
                                                                {*@
                                                            <input class="form-control" id="txtBadge" placeholder="@T5V3Web.Content.Persian.BadgeNumber" name="badgeNumber" type="text" value="@Model.Selected.BadgeNumber.ToString()" />
                                                            @*}*@
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.Number</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.Number" name="employeeNumber" type="text" value="@Model.Selected.EmployeeNumber" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.FirstName</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.FirstName" name="firstName" type="text" value="@Model.Selected.FirstName" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.LastName</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.LastName" name="lastName" type="text" value="@Model.Selected.LastName" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.FatherName</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.FatherName" name="fatherName" type="text" value="@Model.Selected.FatherName" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.NationalNo</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.NationalNo" name="nationalNumber" type="text" value="@Model.Selected.NationalNumber" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.Tel</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.Tel" name="tel" type="text" value="@Model.Selected.Tel" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.Email</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.Email" name="email" type="text" value="@Model.Selected.Email" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.Address</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <input class="form-control" placeholder="@T5V3Web.Content.Persian.Address" name="address" type="text" value="@Model.Selected.Address" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="input-label-w75"></label>
                                                        <input class="input-w300" @(Model.Selected.IsFemale ? "checked=checked" : "") name="gender" type="radio" value="true" />
                                                        <label>@T5V3Web.Content.Persian.Female</label>
                                                        &nbsp;
                                                        <input class="input-w300" @(Model.Selected.IsFemale ? "" : "checked=checked") name="gender" type="radio" value="false" />
                                                        <label>@T5V3Web.Content.Persian.Male</label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-6">
                                                    <div class="form-group">
                                                        @{
                                                            var base64 = Model.Selected.Photo != null ? Convert.ToBase64String(Model.Selected.Photo) : "";
                                                            var imgSrc = String.Format("data:image/gif;base64,{0}", base64);
                                                        }
                                                        <div class="row center-align">
                                                            <img class="block-display" style="margin:auto" id="blah" src="@imgSrc" height="125" width="100" alt="your image" />
                                                        </div>
                                                        <div class="row">
                                                            <input style="margin:auto" class="block-display" type='file' name="photo" onchange="readURL(this);" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.BirthDay</label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            @*<input class="form-control" name="birthday" type="text" value="@T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.Birthday)" />*@
                                                            <input class="datepicker-farsi" style="width:130%" name="birthday" type="text" value="@T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.Birthday)" />
                                                        </div>
                                                        <div class="col-sm-2 text-right">
                                                            @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('birthday', this)">@T5V3Web.Content.Persian.Select</a>*@
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.EmpDate</label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            @*<input class="form-control" name="hiredDay" type="text" value="@T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.HiredDay)" />*@
                                                            <input class="datepicker-farsi" style="width:130%" name="hiredDay" type="text" value="@T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.HiredDay)" />
                                                        </div>
                                                        <div class="col-sm-2 text-right">
                                                            @*<a rel="noopener noreferrer" href="javascript:" onclick="displayDatePicker('hiredDay', this)">@T5V3Web.Content.Persian.Select</a>*@
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.EndWork</label>
                                                            @*<input type="hidden" value="false" name="endWork" />*@
                                                            <input type="checkbox" onclick="disableFiredDate(this)" name="endWork" value="" @(Model.Selected.DeptID == -1 ? "checked=checked" : "")>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input id="txtFiredDate" class="datepicker-farsi" style="width:130%" name="firedDay" disabled="" type="text" value="@(Model.Selected.FiredDay.HasValue ?  T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.FiredDay.Value) : "")" />
                                                            @*<input id="txtFiredDate" class="form-control" name="firedDay" disabled="" type="text" value="@(Model.Selected.FiredDay.HasValue ?  T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.FiredDay.Value) : "")" />*@
                                                        </div>
                                                        <div class="col-sm-2 text-right">
                                                            @*<a rel="noopener noreferrer" id="datePickerFiredDate" href="javascript:" onclick="displayDatePicker('firedDay', this)">@T5V3Web.Content.Persian.Select</a>*@
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.Certificate</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <select class="form-control" name="certificateID">
                                                                @foreach (Personnel.Model.Certificate c in ViewBag.Certificates)
                                                                {
                                                                    <option value="@c.CertificateID" @(c.CertificateID == Model.Selected.CertificateID ? "selected=selected" : "")>@c.CertificateName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.EmpType</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <select class="form-control" name="empTypeID">
                                                                @foreach (Personnel.Model.EmpType c in ViewBag.EmpTypes)
                                                                {
                                                                    <option value="@c.EmpTypeID" @(c.EmpTypeID == Model.Selected.EmpTypeID ? "selected=selected" : "")>@c.EmpTypeName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-3 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.Janbaz</label>
                                                        </div>
                                                        <div class="col-sm-9">
                                                            <select class="form-control" name="janbazCode">
                                                                @{
                                                                    string[] temp = new string[] { T5V3Web.Content.Persian.NON, T5V3Web.Content.Persian.Less25, T5V3Web.Content.Persian.J25_30, T5V3Web.Content.Persian.J35_40, T5V3Web.Content.Persian.J45_50, T5V3Web.Content.Persian.J55_60, T5V3Web.Content.Persian.J65_70, T5V3Web.Content.Persian.JMore70 };
                                                                    for (int j = 0; j < temp.Length; j++)
                                                                    {
                                                                        <option value="@j" @(j == Model.Selected.JanbazCode ? "selected=selected" : "")>@temp[j]</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                        <div id="tabs-2" style="display:table" class="right-align">
                                            @foreach (Personnel.Model.Property pr in (List<Personnel.Model.Property>)ViewBag.Properties)
                                            {
                                                Personnel.Model.UserInfoProperty tempProp = ((List<Personnel.Model.UserInfoProperty>)ViewBag.UserInfoProperties).Where(p => p.PropertyID == pr.PropertyID).FirstOrDefault();

                                                if ((pr.PropertyType == Personnel.Model.PropertyType.StringValue) || (pr.PropertyType == Personnel.Model.PropertyType.DateTimeValue))
                                                {
                                                    string valStr = "";
                                                    if (tempProp != null)
                                                    {
                                                        valStr = tempProp.StringValue;
                                                    }
                                                    <div class="form-group">
                                                        <div class="col-sm-2 text-center">
                                                            <label>@pr.PropertyName</label>
                                                        </div>
                                                        <div class="col-sm-10">
                                                            <input class="form-control" value="@valStr" onkeyup="document.getElementById('@("addProp" + pr.PropertyID.ToString())').value=@(pr.PropertyID)+';' + this.value;" name="@("addProp" + pr.PropertyID.ToString () )" type="text" />
                                                            <input type="hidden" name="addTexts" value="@(pr.PropertyID.ToString() + ";" + valStr)" id="@("addProp" + pr.PropertyID.ToString())" />
                                                        </div>
                                                    </div>
                                                }
                                                if (pr.PropertyType == Personnel.Model.PropertyType.BooleanValue)
                                                {
                                                    bool boolVal = false;
                                                    if (tempProp != null)
                                                    {
                                                        boolVal = bool.Parse(tempProp.StringValue);
                                                    }
                                                    <div class="form-group">
                                                        <input name="addBools" value="@pr.PropertyID" type="checkbox" @(boolVal ? "checked=checked" : "") />
                                                        <label>@pr.PropertyName</label>
                                                    </div>
                                                }
                                                if (pr.PropertyType == Personnel.Model.PropertyType.DropDownValue)
                                                {
                                                    int drpVal = 1;
                                                    if ((tempProp != null) && (tempProp.DropDownValue.HasValue))
                                                    {
                                                        drpVal = tempProp.DropDownValue.Value;
                                                    }
                                                    <div class="form-group">
                                                        <div class="col-sm-2 text-center">
                                                            <label class="control-label">@pr.PropertyName</label>
                                                        </div>
                                                        <div class="col-sm-10">
                                                            <select class="form-control" name="addSelects">
                                                                @foreach (KeyValuePair<int, string> s in (List<KeyValuePair<int, string>>)ViewData["prp" + pr.PropertyID.ToString()])
                                                                {
                                                                    <option @(drpVal == s.Key ? "selected=selected" : "") value="@(pr.PropertyID.ToString() + ";" +  s.Key.ToString())">
                                                                        @s.Value
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <div id="tabs-3">
                                            <div style="display:table">
                                                <div class="col-sm-6 right-align">
                                                    <div class="form-group">
                                                        <div class="col-sm-4 text-center">
                                                            @*<input name="validFrom" value="false" type="hidden" />*@
                                                            <input name="validFrom" value="true" onclick="disablevalidFrom(this)" type="checkbox" @(Model.Selected.ValidFrom.HasValue ? "checked=checked" : "") />
                                                            <label>@T5V3Web.Content.Persian.StartAccess</label>
                                                        </div>
                                                        <div class="col-sm-5">
                                                            <input name="validFromDate" class="form-control left-align" type="text" value="@(Model.Selected.ValidFrom.HasValue ? T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.ValidFrom.Value)  :"")" />
                                                        </div>
                                                        <div class="col-sm-3">
                                                            <input name="validFromTime" class="form-control timespan-input" type="text" value="@(Model.Selected.ValidFrom.HasValue ? (Model.Selected.ValidFrom.Value.ToString("HH:mm"))  :"")" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-4 text-center">
                                                            @*<input name="validTo" value="false" type="hidden" />*@
                                                            <input name="validTo" value="true" type="checkbox" onclick="disablevalidTo(this)" @(Model.Selected.ValidTo.HasValue ? "checked=checked" : "") />
                                                            <label>@T5V3Web.Content.Persian.EndAccess</label>
                                                        </div>
                                                        <div class="col-sm-5">
                                                            <input name="validToDate" class="form-control left-align" type="text" value="@(Model.Selected.ValidTo.HasValue ? T5V3.Misc.DateConverter.ToHijriDate(Model.Selected.ValidTo.Value) : "")" />
                                                        </div>
                                                        <div class="col-sm-3">
                                                            <input name="validToTime" class="form-control timespan-input" type="text" value="@(Model.Selected.ValidTo.HasValue ? (Model.Selected.ValidTo.Value.ToString("HH:mm"))  :"")" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-4 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.UserName</label>
                                                        </div>
                                                        <div class="col-sm-8">
                                                            <input name="userNameEdt" placeholder="@T5V3Web.Content.Persian.UserName" autocomplete="off" class="form-control" type="text" value="" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-4 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.Password</label>
                                                        </div>
                                                        <div class="col-sm-8">
                                                            <input name="passwordEdt" placeholder="@T5V3Web.Content.Persian.Password" autocomplete="off" class="form-control" type="password" value="" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-8 col-sm-offset-4">
                                                            <input name="webUser" value="true" type="checkbox" @(Model.Selected.WebUser ? "checked=checked" : "") />
                                                            <label>@T5V3Web.Content.Persian.WebUser</label>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-8 col-sm-offset-4">
                                                            <input name="programUser" value="true" type="checkbox" @(Model.Selected.ProgramUser ? "checked=checked" : "") />
                                                            <label>@T5V3Web.Content.Persian.ApplicationUser</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-6">
                                                    <label>@T5V3Web.Content.Persian.UploadDevices ...</label>
                                                    <div id="treeUploadDevices">
                                                    </div>
                                                    @*<div class="border-gray auto-scroll w-300 h-200 ">
                                                            @Html.Partial("_DeviceSelection", new T5V3Web.Models.DeviceSelectionModel("uploadDevices", (List<int>)ViewBag.UploadDevices))
                                                        </div>*@
                                                </div>

                                            </div>
                                        </div>
                                        <div id="tabs-4">
                                            <div style="display:table">

                                                <div class="col-sm-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-4 text-center">
                                                            <label class="control-label">@T5V3Web.Content.Persian.DeviceName</label>
                                                        </div>
                                                        <div class="col-sm-8">
                                                            <input name="deviceName" class="form-control" placeholder="@T5V3Web.Content.Persian.DeviceName" type="text" value="@Model.Selected.DeviceName" />
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="col-sm-4 text-center">
