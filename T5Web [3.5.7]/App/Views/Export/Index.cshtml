@{
    ViewBag.Title = T5V3Web.Content.Persian.ExportData;
}

<div class="page-header">
    <h3>@T5V3Web.Content.Persian.ExportData</h3>
</div>

<form class="form-horizontal" action="/Export/GetFile" method="post">
    <div class="panel panel-default">
        <div class="panel-heading">
            <label>@T5V3Web.Content.Persian.SelectPersonnel ...</label>
        </div>
        <div id="panelPersonnel" class="panel-body">
            @Html.Partial("_SelectUser", T5V3Web.Controllers.UserSelectionController.CreateModel(new List<long>()))
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <label>@T5V3Web.Content.Persian.SelectTimeInterval ...</label>
        </div>
        <div class="panel-body">
            @Html.Partial("_SelectDateInterval", new T5V3Web.Models.DateIntervalPickerModel(1, T5V3.Misc.DateConverter.GetHijriYear(DateTime.Now), T5V3.Misc.DateConverter.GetHijriMonth(DateTime.Now)))
        </div>
    </div>
  
      <div class="form-group">
        <div class="col-sm-2">
            <label>@T5V3Web.Content.Persian.ReportName</label>
        </div>
        <div class="col-sm-10">
            <select class="form-control" name="reportID">
                @foreach (T5V3.Model.Reportmdl rep in ViewBag.Reports)
                {
                    <option value="@rep.ReportID">
                        @rep.ReportName
                    </option>
                }
            </select>
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-2">
            <label>@T5V3Web.Content.Persian.Format</label>
        </div>
        <div class="col-sm-10">
            <select class="form-control" name="format">
                <option value="0">Text</option> 
                <option value="1">Excel</option>
                <option value="2">DBF</option>
            </select>
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-2">
            <label>@T5V3Web.Content.Persian.Seprator</label>
        </div>
        <div class="col-sm-10">
            <input type="text" class="form-control" name="seprator"/>
        </div>
    </div>

    <div class="form-group">
        <input type="submit" value="@T5V3Web.Content.Persian.Export" class="btn btn-success btn-lg" />
    </div>
</form>