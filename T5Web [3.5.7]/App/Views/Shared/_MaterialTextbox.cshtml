@model MaterialTextboxModel
<div class="material-input text-right">
    <div class="">
        <div class="group">
            <input name="@Model.InputName" type="text" required value="@Model.InputValue">
            <span class="highlight"></span>
            <span class="bar"></span>
            <label>@Model.Label</label>
        </div>
    </div>
</div>