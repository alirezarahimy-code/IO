@{
    ViewBag.Title = T5V3Web.Content.Persian.Calendar;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.BaseData;
    ViewBag.PageTag = "Calendar";
}

<div class="card-header text-right">
    <h3>@T5V3Web.Content.Persian.Calendar</h3>
</div>
<div class="card">

    @{
        T5V3Web.Models.GridModel grd = new T5V3Web.Models.GridModel();
        grd.DeleteAllAPIPath = "/Calendar/DeleteAll";
        grd.DeleteAPIPath = "/Calendar/Delete/";
        grd.GetListAPIPath = "/Calendar/GetList";
        grd.IDPropertyName = "CalendarID";
        grd.DisplayPropertyName = "CalendarName";
        grd.Columns.Add(new T5V3Web.Models.GridModel.Column(T5V3Web.Content.Persian.CalendarName, "CalendarName"));
        @Html.Partial("_Grid", grd);
    }

    <div id="edit-panel" class="panel panel-default collapsed-visibility">
        <div class="panel-heading">
            <label id="title-panel-label">@T5V3Web.Content.Persian.Edit</label>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">

                <input type="hidden" id="CalendarID" />
                <div class="form-group">
                    <div class="col-sm-2 text-center">
                        <label class="control-label">@T5V3Web.Content.Persian.CalendarName <font style="color:red">*</font></label>
                    </div>
                    <div class="col-sm-10">
                        <input id="txtCalendarName" placeholder="@T5V3Web.Content.Persian.CalendarName" class="form-control" type="text" name="CalendarName" value="" />
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-sm-10 text-right col-sm-offset-2">
                        <a rel="noopener noreferrer" id="holidaysLink" href="#">@T5V3Web.Content.Persian.SelectHolidays</a>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-offset-2 col-sm-10 text-right">
                        <button id="btnEdit" onclick="submitData()" type="button" class="btn btn-success"></button>
                        <button type="button" onclick="invisiblePanel()" class="btn btn-default">@T5V3Web.Content.Persian.Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section modals
        {
        <div id="myModal" class="modal fade" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 id="msg-title" class="modal-title"></h4>
                    </div>
                    <div class="modal-body">
                        <p id="msg-body"></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                    </div>
                </div>

            </div>
        </div>
    }
</div>



@section scripts
{
    <script>
        loadlist(1, "");

        function invisiblePanel() {
            $("#edit-panel").attr("class", "collapsed-visibility panel panel-default");
        }

        function addnew() {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Add2");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Add");

            $("#txtCalendarName").val("");
            $("#CalendarID").val(-1);
            $("#holidaysLink").html("");
        }

        function submitData() {
            var toEdit = { CalendarID: $("#CalendarID").val(), CalendarName: $("#txtCalendarName").val() };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(toEdit),
                type: "POST",
                url: "/Calendar/Edit",
                success: function (data) {
                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();
                    if (toEdit.CertificateID == -1) {
                        loadlist(-1);
                    }
                    else {
                        loadlist($("body").data("page"), $("body").data("squery"));
                    }
                }
            });
            invisiblePanel();
        }

        function loadItem(id) {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Edit");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Edit");
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                type: "GET",
                url: "/Calendar/GetByID/" + id,
                success: function (data) {
                    $("#txtCalendarName").val(data.CalendarName);
                    $("#CalendarID").val(data.CalendarID);
                    $("#holidaysLink").html("@T5V3Web.Content.Persian.SelectHolidays")
                    $("#holidaysLink").attr("href", "/Calendar/Holidays?calendarID=" + data.CalendarID);
                }
            });
        }

    </script>
}


