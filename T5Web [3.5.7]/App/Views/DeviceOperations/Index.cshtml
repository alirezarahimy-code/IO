@model T5V3Web.Models.DeviceOperationsModel
@{
    ViewBag.Title = T5V3Web.Content.Persian.DeviceOperations;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.Devices;
    ViewBag.PageTag = "DeviceOperations";
}

<h3>@T5V3Web.Content.Persian.DeviceOperations</h3>

<div class="horizontal-line"></div>

@if (@Model.HasError)
{
    <div class="validation-message-error">@Html.Raw(Model.ErrorMessage)</div>
}
else
{
    int i = 0;
    <div class="panel panel-warning">
        <div class="panel-heading">
            <label>@T5V3Web.Content.Persian.Devices</label>
        </div>
        <div class="panel-body">
            @foreach (Personnel.Model.Gate gate in Model.Gates)
            {
                <div style="display:table" class="text-right w-100p">
                    <div style="display: table-row;height:50px;">
                        <div style="display:table-cell;padding-top:25px;">
                            <label style="display:inline-block;">
                                <a rel="noopener noreferrer">
                                    <img style="cursor:pointer;vertical-align:middle" class="sh" src="/Images/mg42.png" onclick="shw(@gate.GateID,this)" />
                                </a>
                                @gate.GateName
                            </label>
                        </div>
                    </div>

                    <table class="table table-bordered table-hover table-responsive table-striped">
                        <tbody>
                            @foreach (Personnel.Model.Device device in Model.Devices.Where(d => d.GateID == gate.GateID))
                            {
                                i++;
                                T5V3Web.Models.DeviceState stt = Model.DeviceStates.Where(d => d.MachineNumber == device.MachineNumber).FirstOrDefault();
                                if (stt == null)
                                {
                                    stt = new T5V3Web.Models.DeviceState();
                                }

                                <tr class="grp_@gate.GateID">
                                    <td>
                                        <img data-toggle="tooltip" id="imgcnn_@device.MachineNumber" title="@(string.Format("{0}", stt.Connected ? T5V3Web.Content.Persian.Connected : T5V3Web.Content.Persian.Disconnected))" class="float-right" style="vertical-align:middle" height="20" width="20" src="@(stt.Connected ? "/Images/Connected24.png" : "/Images/Disconnect24.png")" />
                                        <img data-toggle="tooltip" id="imgping_@device.MachineNumber" title="@(string.Format("{0}", stt.Ping ? T5V3Web.Content.Persian.PingIsOK : T5V3Web.Content.Persian.PinkIsNotOK))" class="float-right" style="vertical-align:middle" height="20" width="20" src="@(stt.Ping ? "/Images/pingok.png" : "/Images/noping.png")" />
                                        <img id="imginuse_@device.MachineNumber" title="@T5V3Web.Content.Persian.DeviceInUse" src="/Images/Stop24.png" class="float-right" width="@(stt.InUse ? 20:0)" height="20" style="vertical-align:middle" />
                                    </td>
                                    <td>
                                        <label id="lblmach_@device.MachineNumber">@device.MachineNumber</label>
                                    </td>
                                    <td>
                                        <label>@device.MachineName</label>
                                    </td>
                                    <td>
                                        <label>@device.IP</label>
                                    </td>
                                    <td>
                                        <a rel="noopener noreferrer" id="cdc_@device.MachineNumber" href="@(stt.Connected ? "/DeviceOperations/Disconnect/" + device.MachineNumber : "/DeviceOperations/Connect/" + device.MachineNumber)">
                                            @(stt.Connected ? T5V3Web.Content.Persian.Disconnect : T5V3Web.Content.Persian.Connect)
                                        </a>
                                        @if (stt.Connected)
                                        {
                                            <label>-</label>
                                            <a rel="noopener noreferrer" onclick="readRecords(@device.MachineNumber)" id="dlc_@device.MachineNumber" href="#">
                                                @T5V3Web.Content.Persian.DownloadRecords
                                            </a>
                                            <label>-</label>
                                            <a rel="noopener noreferrer" href="/DeviceOperations/DeviceProperties/@device.MachineNumber">
                                                @T5V3Web.Content.Persian.DeviceProperties
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }
        </div>
    </div>
}

<div>
    <form class="text-left col-sm-6" action="/DeviceOperations/DownloadUsers" method="get">
        <button class="btn btn-default" type="submit">@T5V3Web.Content.Persian.DownloadUsersFromDevice</button>
    </form>
    <form class="text-right col-sm-6" action="/DeviceOperations/UploadUsers" method="get">
        <button class="btn btn-default" type="submit">@T5V3Web.Content.Persian.UploadUsers</button>
    </form>
</div>



<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 id="msg-title" class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <p id="msg-body"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
            </div>
        </div>

    </div>
</div>

<script>
    function readRecords(number) {
        $.ajax({
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            type: "GET",
            url: "/DeviceOperations/GetRecords/" + number,
            success: function (data) {
                $("#msg-title").html(data.Title);
                $("#msg-body").html(data.Message);
                $("#myModal").modal();
            }
        });
    }

    function shw(gateid, lbl) {
        var display = 'table-row'
        if (lbl.className == 'sh') {
            display = 'none';
            lbl.className = 'hd'
            lbl.src = '/Images/pg24.png';
        }
        else {
            lbl.src = '/Images/mg42.png';
            lbl.className = 'sh';
        }
        var eles = document.getElementsByClassName('grp_' + gateid);
        for (var i = 0; i < eles.length; i++)
            eles[i].style.display = display;
    }

    var myVar = setInterval(updaterTimer, 5000);
    function updaterTimer() {
        $.ajaxSetup({ cache: false });
        $.ajax({
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            type: "GET",
            url: "/DeviceOperations/DeviceStates",
            success: function (data) {
                for (var i = 0; i < data.length; i++) {
                    if (data[i].Ping == true) {
                        document.getElementById('imgping_' + data[i].MachineNumber).src = '/Images/pingok.png';
                        document.getElementById('imgping_' + data[i].MachineNumber).title = '@T5V3Web.Content.Persian.PingIsOK';
                    }
                    else {
                        document.getElementById('imgping_' + data[i].MachineNumber).src = '/Images/noping.png';
                        document.getElementById('imgping_' + data[i].MachineNumber).title = '@T5V3Web.Content.Persian.PinkIsNotOK';
                    }
                    if (data[i].Connected == true) {
                        document.getElementById('imgcnn_' + data[i].MachineNumber).src = '/Images/Connected24.png';
                        document.getElementById('imgcnn_' + data[i].MachineNumber).title = '@T5V3Web.Content.Persian.Connected';
                        document.getElementById('cdc_' + data[i].MachineNumber).innerHTML = '@T5V3Web.Content.Persian.Disconnect';
                        document.getElementById('cdc_' + data[i].MachineNumber).href = '/DeviceOperations/Disconnect/' + data[i].MachineNumber;
                    }
                    else {
                        document.getElementById('imgcnn_' + data[i].MachineNumber).src = '/Images/Disconnect24.png';
                        document.getElementById('imgcnn_' + data[i].MachineNumber).title = '@T5V3Web.Content.Persian.Disconnected';
                        document.getElementById('cdc_' + data[i].MachineNumber).innerHTML = '@T5V3Web.Content.Persian.Connect';
                        document.getElementById('cdc_' + data[i].MachineNumber).href = '/DeviceOperations/Connect/' + data[i].MachineNumber;
                    }
                    //if (data[i].InUse == true) {
                        //document.getElementById('imginuse_' + data[i].MachineNumber).width = 20;
                        //document.getElementById('lblmach_' + data[i].MachineNumber).style.marginRight = '30px';
                    //}
                    //else {
                        //document.getElementById('imginuse_' + data[i].MachineNumber).width = 0;
                        //document.getElementById('lblmach_' + data[i].MachineNumber).style.marginRight = '50px';
                    //}
                }
            }
        })
    }
</script>