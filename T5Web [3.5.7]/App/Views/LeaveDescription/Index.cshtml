@{
    ViewBag.Title = T5V3Web.Content.Persian.LeaveDescription;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.BaseData;
    ViewBag.PageTag = "LeaveDescription";
}

<div class="page-header">
    <h3>@T5V3Web.Content.Persian.LeaveDescription</h3>
</div>

@{
    T5V3Web.Models.GridModel grd = new T5V3Web.Models.GridModel();
    grd.DeleteAllAPIPath = "/LeaveDescription/DeleteAll";
    grd.DeleteAPIPath = "/LeaveDescription/Delete/";
    grd.GetListAPIPath = "/LeaveDescription/GetList";
    grd.IDPropertyName = "ID";
    grd.DisplayPropertyName = "Description";
    grd.Columns.Add(new T5V3Web.Models.GridModel.Column(T5V3Web.Content.Persian.LeaveDescription, "Description"));
    @Html.Partial("_Grid", grd);
}

<div id="edit-panel" class="panel panel-default collapsed-visibility">
    <div class="panel-heading">
        <label id="title-panel-label">@T5V3Web.Content.Persian.Edit</label>
    </div>
    <div class="panel-body">
        <form class="form-horizontal" role="form" method="post" action="/LeaveDescription/Edit">
            <input type="hidden" id="leaveDescriptionID" />
            <div class="form-group">
                <div class="col-sm-2 text-center">
                    <label class="control-label">@T5V3Web.Content.Persian.Descriptions<font style="color:red">*</font></label>
                </div>
                <div class="col-sm-10">
                    <input id="txtDescription" placeholder="@T5V3Web.Content.Persian.Descriptions" class="form-control" type="text" name="Description" value="" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-center">
                    <label class="control-label">@T5V3Web.Content.Persian.LeaveType<font style="color:red">*</font></label>
                </div>
                <div class="col-sm-10">
                    <select id="cmbForLeaveType" class="form-control">
                        <option value="@((int)T5V3.Model.LeaveTypeEnum.Duty)">@T5V3Web.Content.Persian.Duty</option>
                        <option value="@((int)T5V3.Model.LeaveTypeEnum.Leave)">@T5V3Web.Content.Persian.Leave</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <button id="btnEdit" onclick="submitData()" type="button" class="btn btn-success"></button>
                    <button type="button" onclick="invisiblePanel()" class="btn btn-default">@T5V3Web.Content.Persian.Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>


@section modals
{
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 id="msg-title" class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <p id="msg-body"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                </div>
            </div>

        </div>
    </div>
}




@section scripts
{
    <script>
        loadlist(1, "");

        function invisiblePanel() {
            $("#edit-panel").attr("class", "collapsed-visibility panel panel-default");
        }

        function addnew() {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Add2");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Add");

            $("#txtDescription").val("");
            $("#leaveDescriptionID").val(-1);
        }

        function submitData() {
            var toEdit = { ID: $("#leaveDescriptionID").val(), ForLeaveType: $("#cmbForLeaveType").val(), Description: $("#txtDescription").val() };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(toEdit),
                type: "POST",
                url: "/LeaveDescription/Edit",
                success: function (data) {
                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();
                    if (toEdit.EmpTypeID == -1) {
                        loadlist(-1);
                    }
                    else {
                        loadlist($("body").data("page"), $("body").data("squery"));
                    }
                }
            });
            invisiblePanel();
        }

        function loadItem(id) {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Edit");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Edit");
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                type: "GET",
                url: "/LeaveDescription/GetByID/" + id,
                success: function (data) {
                    $("#cmbForLeaveType").val(data.ForLeaveType);
                    $("#txtDescription").val(data.Description);
                    $("#leaveDescriptionID").val(data.ID);
                }
            });
        }

    </script>
}


