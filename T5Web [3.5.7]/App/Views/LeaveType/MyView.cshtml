            </div>
            <div class="col-sm-10">
                @if (Model.Selected != null)
                {
                    <text>
                        <select class="form-control" name="GetInType">
                            <option @((Model.Selected.GetInType == T5V3.Model.LeaveGetInType.MonthFirst) ? "selected=selected" : "") value="@T5V3.Model.LeaveGetInType.MonthFirst">@T5V3Web.Content.Persian.MonthFirst</option>
                            <option @((Model.Selected.GetInType == T5V3.Model.LeaveGetInType.MonthLast) ? "selected=selected" : "") value="@T5V3.Model.LeaveGetInType.MonthLast">@T5V3Web.Content.Persian.MonthLast</option>
                            <option @((Model.Selected.GetInType == T5V3.Model.LeaveGetInType.YearFirst) ? "selected=selected" : "") value="@T5V3.Model.LeaveGetInType.YearFirst">@T5V3Web.Content.Persian.YearFirst</option>
                            <option @((Model.Selected.GetInType == T5V3.Model.LeaveGetInType.YearLast) ? "selected=selected" : "") value="@T5V3.Model.LeaveGetInType.YearLast">@T5V3Web.Content.Persian.YearLast</option>
                            <option @((Model.Selected.GetInType == T5V3.Model.LeaveGetInType.Custom) ? "selected=selected" : "") value="@T5V3.Model.LeaveGetInType.Custom">@T5V3Web.Content.Persian.Custom</option>
                        </select>
                    </text>
                }
                else
                {
                    <text>
                        <select class="form-control" name="GetInType">
                            <option selected="selected" value="@T5V3.Model.LeaveGetInType.MonthFirst">@T5V3Web.Content.Persian.MonthFirst</option>
                            <option value="@T5V3.Model.LeaveGetInType.MonthLast">@T5V3Web.Content.Persian.MonthLast</option>
                            <option value="@T5V3.Model.LeaveGetInType.YearFirst">@T5V3Web.Content.Persian.YearFirst</option>
                            <option value="@T5V3.Model.LeaveGetInType.YearLast">@T5V3Web.Content.Persian.YearLast</option>
                            <option value="@T5V3.Model.LeaveGetInType.Custom">@T5V3Web.Content.Persian.Custom</option>
                        </select>
                    </text>
                }
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-2 text-center">
                <label class="control-label">@T5V3Web.Content.Persian.Parameter</label>
            </div>
            <div class="col-sm-10">
                @Html.DropDownList("ParameterID", (List<SelectListItem>)ViewBag.UserParameters, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-2 text-center">
                <label class="control-label">@T5V3Web.Content.Persian.ForNextYear</label>
            </div>
            <div class="col-sm-10">
                <input class="form-control" placeholder="@T5V3Web.Content.Persian.ForNextYear" name="ForNextYear" type="number" step="0.1" value="@(Model.Selected !=null ? Model.Selected.ForNextYear : 9)" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-2 text-center">
                <label class="control-label"></label>
            </div>
            <div class="col-sm-10 text-right">
                <input type="checkbox" name="ForNextYearSum" value="true" @(((Model.Selected != null) && Model.Selected.ForNextYearSum) ? " checked=checked" : "") />
                <label>@T5V3Web.Content.Persian.NextYearSum</label>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-2 text-center">
                <label class="control-label">@T5V3Web.Content.Persian.MaxMinus</label>
            </div>
            <div class="col-sm-10">
                <input name="MaxMinus" class="form-control" placeholder="@T5V3Web.Content.Persian.MaxMinus" type="number" step="0.1" value="@(Model.Selected !=null ? Model.Selected.MaxMinus :0)" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2 text-right">
                <input type="checkbox" name="Payment" value="true" @(((Model.Selected != null) && Model.Selected.Payment) ? " checked=checked" : "") />
                <label>@T5V3Web.Content.Persian.WOPayment</label>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-2 text-center">
                <label class="control-label">@T5V3Web.Content.Persian.DecreaseFrom</label>
            </div>
            <div class="col-sm-10">
                @Html.DropDownList("DecreaseFromLeaveID", (List<SelectListItem>)ViewBag.LeaveTypes, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2 text-right">
                <input type="checkbox" name="GetInHolidays" value="true" @(((Model.Selected != null) && Model.Selected.GetInHolidays) ? " checked=checked" : "") />
                <label>@T5V3Web.Content.Persian.GetInHolidays</label>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2 text-right">
                <input type="checkbox" name="AutoInHolidays" value="true" @(((Model.Selected != null) && Model.Selected.AutoInHolidays) ? " checked=checked" : "") />
                <label>@T5V3Web.Content.Persian.AutoInHolidays</label>
            </div>
        </div>

        <div class="form-group">
            @if (Model.Selected != null)
            {
                <input name="LeaveTypeID" type="hidden" value="@Model.Selected.LeaveTypeID" />
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <input class="btn btn-default" type="submit" value="@(string.Format ("{0} {1}", T5V3Web.Content.Persian.Edit , T5V3Web.Content.Persian.LeaveType))" />
                </div>
            }
            else
            {
                <input name="LeaveTypeID" type="hidden" value="-1" />
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <input class="btn btn-default" type="submit" value="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Add2, T5V3Web.Content.Persian.LeaveType))" />
                </div>
            }
        </div>

        <div class="form-group">
            <div class="col-sm-offset-1 col-sm-10 text-center">
                @if (Model.ValidationMessage != null)
                {
                    <div class="@((T5V3Web.Models.ValidationMessageType)Model.ValidationMessageType == T5V3Web.Models.ValidationMessageType.Error ? "alert alert-danger fade in" : "alert alert-success fade in")">
                        @Model.ValidationMessage
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                    </div>
                }
            </div>
        </div>

    </form>

    <div class="horizontal-line"></div>

    <table class="table table-bordered table-hover table-responsive table-striped">
        <thead>
            <tr class="warning">
                <td>@T5V3Web.Content.Persian.SelectDeleteEdit</td>
                <td>@T5V3Web.Content.Persian.LeaveName</td>
                <td>@T5V3Web.Content.Persian.LeaveType</td>
                <td></td>
            </tr>
        </thead>
        <tbody>
            @foreach (T5V3.Model.LeaveType c in Model.ItemsList)
            {
                <tr>
                    <td>
                        <input data-toggle="tooltip" type="checkbox" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Select, c.LeaveName))" name="ids" value="@c.LeaveTypeID" />
                        <a onclick="confirmDelete(@c.LeaveTypeID)" href="javascript:void(0)">
                            <span data-toggle="tooltip" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Delete, c.LeaveName))" class="glyphicon glyphicon-remove"></span>
                        </a>
                        <a data-toggle="tooltip" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Edit, c.LeaveName))" href="/LeaveType?pageNumber=@Model.PageNumber&leaveTypeID=@c.LeaveTypeID">
                            <span class="glyphicon glyphicon-edit"></span>
                        </a>
                    </td>
                    <td>
                        <label>@c.LeaveName</label>
                    </td>
                    <td>
                        <label>@(c.LeaveType1 == T5V3.Model.LeaveTypeEnum.Duty ? T5V3Web.Content.Persian.Duty : T5V3Web.Content.Persian.Leave)</label>
                    </td>
                    <td>
                        <label>@(c.IsHourly ? T5V3Web.Content.Persian.Hourly : T5V3Web.Content.Persian.Daily) </label>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="danger">
                <td>
                    <form role="form" method="get" action="/LeaveType?pageNumber=@Model.PageNumber">
                        <div class="btn-group">
                            <button type="submit" class="btn btn-sm btn-default" data-toggle="tooltip" title="@T5V3Web.Content.Persian.Add">
                                <span class="glyphicon glyphicon-plus"></span>
                            </button>
                            <button type="button" class="btn btn-sm btn-default" data-toggle="tooltip" title="@T5V3Web.Content.Persian.DeleteSelectedItems" onclick="deleteAll()">
                                <span class="glyphicon glyphicon-remove"></span>
                            </button>
                        </div>
                    </form>
                </td>
                <td colspan="3">
                    @if (Model.HasPrePage)
                    {
                        <a data-toggle="tooltip" title="@T5V3Web.Content.Persian.Previous" href="/LeaveType?pageNumber=@(Model.PageNumber-1)"><span class="glyphicon glyphicon-forward"></span></a>
                    }
                    else
                    {
                        <span class="glyphicon glyphicon-forward"></span>
                    }

                    <label>@(string.Format("{3} {0} {1} {2}", Model.PageNumber.ToString(), T5V3Web.Content.Persian.From, Model.TotalPageNumbers.ToString(), T5V3Web.Content.Persian.Page))</label>

                    @if (Model.HasNextPage)
                    {
                        <a data-toggle="tooltip" title="@T5V3Web.Content.Persian.Next" href="/LeaveType?pageNumber=@(Model.PageNumber+1)"><span class="glyphicon glyphicon-backward"></span></a>
                    }
                    else
                    {
                        <span class="glyphicon glyphicon-backward"></span>
                    }
                </td>
            </tr>
        </tfoot>
    </table>


    @section scripts
    {
        <script>
            $(function () {
                $(".timespan-input").mask('99:59');
            })
        </script>

        @{
            ViewDataDictionary temp = new ViewDataDictionary();
            temp.Add(new KeyValuePair<string, object>("DeleteUrl", "/LeaveType/Delete"));
            temp.Add(new KeyValuePair<string, object>("DeleteAllUrl", "/LeaveType/DeleteAll"));
            @Html.Partial("_ConfirmDeleteScripts", temp);
        }
    }*@