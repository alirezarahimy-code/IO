@model T5V3Web.Models.InsertRecordModel
@{
    ViewBag.Title = T5V3Web.Content.Persian.InsertRecord;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.AttendanceData;
    ViewBag.PageTag = "InsertRecord";
}
