@model int
@{
    ViewBag.Title = T5V3Web.Content.Persian.ReportTextboxes;
}

<div class="page-header">
    <h3>@T5V3Web.Content.Persian.ReportTextboxes (@ViewBag.ReportName )</h3>
</div>

@{
    T5V3Web.Models.GridModel grd = new T5V3Web.Models.GridModel();
    grd.WithParentID = true;
    grd.ParentID = Model;
    grd.DeleteAllAPIPath = "/ReportTextbox/DeleteAll";
    grd.DeleteAPIPath = "/ReportTextbox/Delete/";
    grd.GetListAPIPath = "/ReportTextbox/GetList";
    grd.IDPropertyName = "TextboxID";
    grd.DisplayPropertyName = "Text";
    grd.Columns.Add(new T5V3Web.Models.GridModel.Column(T5V3Web.Content.Persian.Text, "Text"));
    @Html.Partial("_Grid", grd);
}

<div id="edit-panel" class="panel panel-default collapsed-visibility">
    <div class="panel-heading">
        <label id="title-panel-label">@T5V3Web.Content.Persian.Edit</label>
    </div>
    <div class="panel-body">
        <div class="form-horizontal">

            <input type="hidden" id="reportTextboxID" />

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.Location</label>
                </div>
                <div class="col-sm-10">
                    <select id="cmbLocationType" class="form-control">
                        <option value="0">@(T5V3Web.Content.Persian.PageBody)</option>
                        <option value="1">@(T5V3Web.Content.Persian.Header)</option>
                        <option value="2">@(T5V3Web.Content.Persian.Footer)</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-offset-2 text-right">
                    <input id="rdoParam" name="rdoType" type="radio" value="true" />
                    <label>@T5V3Web.Content.Persian.Parameter</label>&nbsp;
                    <input id="rdoText" name="rdoType" type="radio" value="false" />
                    <label>@T5V3Web.Content.Persian.Text</label>
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.ParameterName</label>
                </div>
                <div class="col-sm-10">
                    <select id="cmbReportData" class="form-control">
                        @foreach (KeyValuePair<string, string> rd in (List<KeyValuePair<string, string>>)ViewBag.Datas)
                        {
                            <option value="@rd.Key">@rd.Value</option>
                        }
                    </select>
                </div>
            </div>


            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.Text</label>
                </div>
                <div class="col-sm-10">
                    <input id="txtText" value="" type="text" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.Up</label>
                </div>
                <div class="col-sm-10">
                    <input id="txtUp" class="form-control" type="number" value="true" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.Left</label>
                </div>
                <div class="col-sm-10">
                    <input id="txtLeft" class="form-control" type="number" value="true" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.Width</label>
                </div>
                <div class="col-sm-10">
                    <input id="txtWidth" class="form-control" type="number" value="true" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.Height</label>
                </div>
                <div class="col-sm-10">
                    <input id="txtHeight" class="form-control" type="number" value="true" />
                </div>
            </div>


            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <button id="btnEdit" onclick="submitData()" type="button" class="btn btn-success"></button>
                    <button type="button" onclick="invisiblePanel()" class="btn btn-default">@T5V3Web.Content.Persian.Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section modals
{
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 id="msg-title" class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <p id="msg-body"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                </div>
            </div>

        </div>
    </div>
}



@section scripts
{
    <script>
        loadlistid(@(Model), 1, "");

        function invisiblePanel() {
            $("#edit-panel").attr("class", "collapsed-visibility panel panel-default");
        }

        function addnew() {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Add2");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Add");

            $("#cmbLocationType").val(0);
            $("#txtText").val("");
            $("#txtUp").val("");
            $("#txtLeft").val("");
            $("#txtWidth").val("");
            $("#txtHeight").val("");
            $("#reportTextboxID").val(-1);
            $("#rdoParam").removeAttr("checked");
            $("#rdoText").attr("checked", "checked");
        }

        function submitData() {
            var t = $("#txtText").val();
            if ($('#rdoParam').is(':checked'))
                t = $('#cmbReportData').val();

            var toEdit = {
                TextboxID: $("#reportTextboxID").val(),
                ReportID: @Model,
                Text: t,
                Top: $("#txtUp").val(),
                Left: $("#txtLeft").val(),
                Height: $("#txtHeight").val(),
                Width: $("#txtWidth").val(),
                LocationType: $("#cmbLocationType").val()
            };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(toEdit),
                type: "POST",
                url: "/ReportTextbox/Edit",
                success: function (data) {
                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();
                    if (toEdit.ReportDataID == -1) {
                        loadlistid(@(Model), -1, "");
                    }
                    else {
                        loadlistid(@(Model),$("body").data("page"), $("body").data("squery"));
                    }
                }
            });
            invisiblePanel();
        }

        function loadItem(id) {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Edit");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Edit");
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                type: "GET",
                url: "/ReportTextbox/GetByID/" + id,
                success: function (data) {
                    $("#cmbLocationType").val(data.LocationType);
                    $("#txtText").val(data.Text);
                    $("#txtUp").val(data.Top);
                    $("#txtLeft").val(data.Left);
                    $("#txtWidth").val(data.Width);
                    $("#txtHeight").val(data.Height);
                    $("#reportTextboxID").val(data.TextboxID);
                    $("#rdoParam").removeAttr("checked");
                    $('#rdoText').prop("checked", true);
                }
            });
        }

    </script>
}