@model int
@{
    ViewBag.Title = T5V3Web.Content.Persian.ReportTablixColumns;
}

<div class="page-header">
    <h3>@T5V3Web.Content.Persian.ReportTablixColumns</h3>
</div>

@{
    T5V3Web.Models.GridModel grd = new T5V3Web.Models.GridModel();
    grd.WithParentID = true;
    grd.ParentID = Model;
    grd.DeleteAllAPIPath = "/ReportTablixColumn/DeleteAll";
    grd.DeleteAPIPath = "/ReportTablixColumn/Delete/";
    grd.GetListAPIPath = "/ReportTablixColumn/GetList";
    grd.IDPropertyName = "ColumnID";
    grd.DisplayPropertyName = "HeaderText";
    grd.Columns.Add(new T5V3Web.Models.GridModel.Column(T5V3Web.Content.Persian.Parameter, "HeaderText"));
    @Html.Partial("_Grid", grd);
}

<div id="edit-panel" class="panel panel-default collapsed-visibility">
    <div class="panel-heading">
        <label id="title-panel-label">@T5V3Web.Content.Persian.Edit</label>
    </div>
    <div class="panel-body">
        <div class="form-horizontal">

            <input type="hidden" id="tablixColumnID" />

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.ColumnHeaderText</label>
                </div>
                <div class="col-sm-10">
                    <input id="txtColumnName" value="" type="text" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.Width</label>
                </div>
                <div class="col-sm-10">
                    <input id="txtWidth" class="form-control" type="number" value="true" />
                </div>
            </div>


            <div class="form-group">
                <div class="col-sm-2 text-left">
                    <label class="control-label">@T5V3Web.Content.Persian.ParameterName</label>
                </div>
                <div class="col-sm-10">
                    <select id="cmbReportData" class="form-control">
                        @foreach (KeyValuePair<string, string> rd in (List<KeyValuePair<string, string>>)ViewBag.Datas)
                        {
                            <option value="@rd.Key">@rd.Value</option>
                        }
                    </select>
                </div>
            </div>



            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <button id="btnEdit" onclick="submitData()" type="button" class="btn btn-success"></button>
                    <button type="button" onclick="invisiblePanel()" class="btn btn-default">@T5V3Web.Content.Persian.Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section modals
{
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 id="msg-title" class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <p id="msg-body"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@T5V3Web.Content.Persian.OK</button>
                </div>
            </div>

        </div>
    </div>
}



@section scripts
{
    <script>
        loadlistid(@(Model), 1, "");

        function invisiblePanel() {
            $("#edit-panel").attr("class", "collapsed-visibility panel panel-default");
        }

        function addnew() {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Add2");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Add");

            $("#txtWidth").val("1");
            $("#txtColumnName").val("");
            $("#tablixColumnID").val(-1);
        }

        function submitData() {
            var toEdit = {
                ColumnID: $("#tablixColumnID").val(),
                TablixID: @Model,
                Width:$("#txtWidth").val(),
                ValueText: $("#cmbReportData").val(),
                HeaderText: $("#txtColumnName").val()
            };
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(toEdit),
                type: "POST",
                url: "/ReportTablixColumn/Edit",
                success: function (data) {
                    $("#msg-title").html(data.Title);
                    $("#msg-body").html(data.Message);
                    $("#myModal").modal();
                    if (toEdit.ColumnID == -1) {
                        loadlistid(@(Model), -1, "");
                    }
                    else {
                        loadlistid(@(Model),$("body").data("page"), $("body").data("squery"));
                    }
                }
            });
            invisiblePanel();
        }

        function loadItem(id) {
            $("#edit-panel").attr("class", "visisble-visibility panel panel-default");
            $('html, body').animate({
                scrollTop: $("#edit-panel").offset().top
            }, 500);
            $("#title-panel-label").html("@T5V3Web.Content.Persian.Edit");
            $("#btnEdit").html("@T5V3Web.Content.Persian.Edit");
            $.ajax({
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                type: "GET",
                url: "/ReportTablixColumn/GetByID/" + id,
                success: function (data) {

                    $("#txtWidth").val(data.Width);
                    $("#txtColumnName").val(data.HeaderText);
                    $("#tablixColumnID").val(data.ColumnID);
                    $("#cmbReportData").val(data.ValueText);

                }
            });
        }

    </script>
}