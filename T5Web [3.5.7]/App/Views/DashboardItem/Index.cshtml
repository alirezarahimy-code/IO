@model T5V3Web.Models.DataEntryModel<Personnel.Model.DashboardItem>

@{
    ViewBag.Title = T5V3Web.Content.Persian.DashboardItems;
    ViewBag.MainMenuItem = T5V3Web.Models.MainMenuItem.Home;
}


<h3>@T5V3Web.Content.Persian.DashboardItems</h3>

<div class="horizontal-line"></div>


<div>
    <form class="form-horizontal" role="form" method="post" action="/DashboardItem/Edit">
        <div class="form-group">
            <div class="col-sm-2 text-center">
                <label class="control-label">@T5V3Web.Content.Persian.GroupName</label>
            </div>
            <div class="col-sm-10">
                <select name="GroupID" class="form-control">
                    @foreach (Personnel.Model.DashboardModel d in ViewBag.Groups)
                    {
                        if (Model.Selected != null)
                        {
                            <option value="@d.ID" @(Model.Selected.GroupID == d.ID ? "selected=selected" : "")>
                                @d.GroupName
                            </option>
                        }
                        else
                        {
                            <option value="@d.ID">
                                @d.GroupName
                            </option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <div class="col-sm-2 text-center">
                <label class="control-label">@T5V3Web.Content.Persian.Item</label>
            </div>
            <div class="col-sm-10">
                <select name="ItemID" class="form-control">
                    @foreach (T5V3Web.Misc.HomePageLinksData.LinkItem l in ViewBag.Items)
                    {
                        if (Model.Selected != null)
                        {
                            <option value="@l.ID" @(Model.Selected.ItemID == l.ID ? "selected=selected" : "")>
                                @l.Title
                            </option>
                        }
                        else
                        {
                            <option value="@l.ID">
                                @l.Title
                            </option>
                        }
                    }
                </select>
            </div>
        </div>


        <div class="form-group">
            @if (Model.Selected != null)
            {
                <input name="ID" type="hidden" value="@Model.Selected.ID" />
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <input class="btn btn-default" type="submit" value="@(string.Format ("{0} {1}", T5V3Web.Content.Persian.Edit , T5V3Web.Content.Persian.Item))" />
                </div>
            }
            else
            {
                <input name="ID" type="hidden" value="-1" />
                <div class="col-sm-offset-2 col-sm-10 text-right">
                    <button class="btn btn-default" type="submit">
                        <span>@(string.Format("{0} {1}", T5V3Web.Content.Persian.Add2, T5V3Web.Content.Persian.Item))</span>
                    </button>
                </div>
            }
        </div>


        <div class="form-group">
            <div class="col-sm-offset-1 col-sm-10 text-center">
                @if (Model.ValidationMessage != null)
                {
                    <div class="@((T5V3Web.Models.ValidationMessageType)Model.ValidationMessageType == T5V3Web.Models.ValidationMessageType.Error ? "alert alert-danger fade in" : "alert alert-success fade in")">
                        @Model.ValidationMessage
                        <a rel="noopener noreferrer" href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                    </div>
                }
            </div>
        </div>

    </form>
</div>

<div class="horizontal-line"></div>

<table class="table table-hover table-bordered table-striped table-responsive">
    <thead>
        <tr class="warning">
            <td>@T5V3Web.Content.Persian.SelectDeleteEdit</td>
            <td>@T5V3Web.Content.Persian.Item</td>
        </tr>
    </thead>
    <tbody>
        @{
            foreach (Personnel.Model.DashboardItem c in Model.ItemsList)
            {
                <tr>
                    <td>
                        <input data-toggle="tooltip" type="checkbox" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Select, T5V3Web.Misc.HomePageLinksData.GetByID(c.ItemID).Title))" name="ids" value="@c.ID" />
                        <a rel="noopener noreferrer" onclick="confirmDelete(@c.ID)" href="javascript:void(0)">
                            <span data-toggle="tooltip" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Delete,T5V3Web.Misc.HomePageLinksData.GetByID ( c.ItemID).Title))" class="glyphicon glyphicon-remove"></span>
                        </a>
                        <a rel="noopener noreferrer" data-toggle="tooltip" title="@(string.Format("{0} {1}", T5V3Web.Content.Persian.Edit, T5V3Web.Misc.HomePageLinksData.GetByID ( c.ItemID).Title))" href="/DashboardItem?pageNumber=@Model.PageNumber&id=@c.ID">
                            <span class="glyphicon glyphicon-edit"></span>
                        </a>
                    </td>
                    <td>
                        <label class="vertical-middle">@(T5V3Web.Misc.HomePageLinksData.GetByID(c.ItemID).Title)</label>
                    </td>

                </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr class="danger">
            <td>
                <form role="form" method="get" action="/DashboardItem?pageNumber=@Model.PageNumber">
                    <div class="btn-group">
                        <button type="submit" class="btn btn-sm btn-default" data-toggle="tooltip" title="@T5V3Web.Content.Persian.Add">
                            <span class="glyphicon glyphicon-plus"></span>
                        </button>
                        <button type="button" class="btn btn-sm btn-default" data-toggle="tooltip" title="@T5V3Web.Content.Persian.DeleteSelectedItems" onclick="deleteAll()">
                            <span class="glyphicon glyphicon-remove"></span>
                        </button>
                    </div>
                </form>
            </td>
            <td>
                @if (Model.HasPrePage)
                {
                    <a rel="noopener noreferrer" data-toggle="tooltip" title="@T5V3Web.Content.Persian.Previous" href="/DashboardItem?pageNumber=@(Model.PageNumber-1)"><span class="glyphicon glyphicon-forward"></span></a>
                }
                else
                {
                    <span class="glyphicon glyphicon-forward"></span>
                }

                <label>@(string.Format("{3} {0} {1} {2}", Model.PageNumber.ToString(), T5V3Web.Content.Persian.From, Model.TotalPageNumbers.ToString(), T5V3Web.Content.Persian.Page))</label>

                @if (Model.HasNextPage)
                {
                    <a rel="noopener noreferrer" data-toggle="tooltip" title="@T5V3Web.Content.Persian.Next" href="/DashboardItem?pageNumber=@(Model.PageNumber+1)"><span class="glyphicon glyphicon-backward"></span></a>
                }
                else
                {
                    <span class="glyphicon glyphicon-backward"></span>
                }
            </td>
        </tr>
    </tfoot>
</table>

@section scripts
{
    @{
        ViewDataDictionary temp = new ViewDataDictionary();
        temp.Add(new KeyValuePair<string, object>("DeleteUrl", "/DashboardItem/Delete"));
        temp.Add(new KeyValuePair<string, object>("DeleteAllUrl", "/DashboardItem/DeleteAll"));
        @Html.Partial("_ConfirmDeleteScripts", temp);
    }
}