  "regression": {
    "initialWindowsFailureRuns": [
      43289488608,
      43289958408
    ],
    "failure": "Task.WhenAll kept waiting for child exit after the frame parser rejected a serial. The child could block on its unread pipe, delaying failure until timeout.",
    "fix": "NativeInteraction.RunAsync fails the interaction on the first fault/cancel so the owning supervisor finally kills the child. Remaining aggregate faults are observed. Applied to generic, user-read and attendance-read supervisors.",
    "guard": "After a wrong-serial header, virtual device sends 8192 extra frames. Expect bridge-failed with zero delivered rows, not timed-out.",
    "localBeforeFixControl": "Actually rebuilt with old Task.WhenAll, ran --virtual-lab and observed nonzero exit at the serial-mismatch assertion; restored fix and rebuilt.",
    "localAfterFix": "0 build warnings/errors; all 19 virtual and all 61 existing portable checks passed.",
    "writeSafety": "Any post-dispatch write exception or missing output remains unknown; no automatic write retry was added."
  },
