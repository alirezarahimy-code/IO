# Installation template only: provision the account, paths and ACLs before enabling.
# Native ZK COM is Windows-only. This unit is for supported Linux worker functions.
[Unit]
Description=IO Device Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=io-device-worker
Group=io-device-worker
WorkingDirectory=/opt/io/device-worker
ExecStart=/usr/bin/dotnet /opt/io/device-worker/IO.DeviceWorker.dll
EnvironmentFile=/etc/io/device-worker.env
Environment=DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
