<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="T5CnnStr" connectionString="Data Source=.;Initial Catalog=ReportT5V3;Integrated Security=True;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />
    <add name="Personnel" connectionString="Data Source=.;Initial Catalog=Personnel;Integrated Security=True;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="AppName" value="سامانه حضور و غیاب و کارتابل آریا" />
    <add key="AppVersion" value="Aria v5.0" />
    <add key="ProductCode" value="ARIA" />
    <add key="LicenseMode" value="Zero-Lock" />
    <add key="HardwareLockEnabled" value="false" />
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="LogoPath" value="" />
    <add key="RequestRecordsDailyLimit" value="-1" />
    <add key="RequestRecordsMonthlyLimit" value="-1" />
    <add key="ValidLateEarly" value="true" />
    <add key="ValidHourlyFree" value="false" />
    <add key="HoursOfDays" value="8" />
    <add key="MaxRequestAgeDays" value="60" />
    <add key="LastDayForRequest" value="31" />
    <add key="ShowDays" value="30" />
    <add key="RequestsLock" value="0" />
    <add key="LeaveID" value="1" />
    <add key="Limit1LeaveID" value="-1" />
    <add key="HideLeaveTypes" value="0" />
    <add key="ViewDailyDuty" value="true" />
    <add key="ViewHourlyDuty" value="true" />
    <add key="ViewDailyLeave" value="true" />
    <add key="ViewHourlyLeave" value="true" />
    <add key="ViewOverTimeRequest" value="true" />
    <add key="ViewRewPen" value="true" />
    <add key="ViewConstOT" value="true" />
    <add key="RequestForUsers" value="false" />
    <add key="RequestRecord" value="true" />
    <add key="ExportReport" value="true" />
    <add key="ReportExport" value="true" />
    <add key="ChangePassRestriction" value="false" />
    <add key="ChangePassMonthly" value="false" />
    <add key="ChangePassLimit" value="3" />
    <add key="ChangePassForce" value="false" />
    <add key="CookiesSecure" value="false" />
    <add key="CookiesTime" value="30" />
    <add key="Captcha" value="false" />
    <add key="LockIP" value="" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <httpRuntime maxRequestLength="20480" executionTimeout="3600" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Shared/Error" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Optimization" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
