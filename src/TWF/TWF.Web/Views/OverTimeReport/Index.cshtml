@model MyTime3.Models.ReportModel
@{
    ViewBag.Title = MyTime3.Content.PersianString.OverTimeReport;
}

<div class="twf-card">
    <div class="twf-card-header">
        <h3 class="twf-card-title">@MyTime3.Content.PersianString.OverTimeReport</h3>
    </div>
    <div class="twf-card-body">
        @using (Html.BeginForm("Show", "OverTimeReport", FormMethod.Get, new { @class = "twf-form" }))
        {
            if (Model != null && !string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="twf-alert twf-alert-danger">@Model.ErrorMessage</div>
            }

            <div style="margin-bottom:16px;">
                @Html.Partial("~/Views/Shared/_SelectMultiUser.cshtml")
            </div>

            <div class="twf-grid" style="grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; align-items:end; margin-bottom:16px;">
                <div class="twf-field">
                    <label class="twf-label">@MyTime3.Content.PersianString.FromDate</label>
                    @Html.TextBoxFor(m => m.FromDateHijri, new { @class = "twf-input twf-num datepicker-farsi", dir = "ltr" })
                </div>
                <div class="twf-field">
                    <label class="twf-label">@MyTime3.Content.PersianString.ToDate</label>
                    @Html.TextBoxFor(m => m.ToDateHijri, new { @class = "twf-input twf-num datepicker-farsi", dir = "ltr" })
                </div>
                <div class="twf-field">
                    <label style="cursor:pointer; display:flex; align-items:center; gap:8px;">
                        <input type="checkbox" value="true" name="showAllDays" />
                        <span>@MyTime3.Content.PersianString.ShowAllDays</span>
                    </label>
                </div>
            </div>

            <div class="twf-actions">
                <button type="submit" class="twf-btn twf-btn-primary">@MyTime3.Content.PersianString.ShowReport</button>
            </div>
        }
    </div>
</div>
