@model MyTime3.Models.ShowRequestModel
@{
    ViewBag.Title = MyTime3.Content.PersianString.RequestsStatus;
}

<div class="twf-card">
    <div class="twf-card-header">
        <h3 class="twf-card-title">@MyTime3.Content.PersianString.RequestsStatus</h3>
    </div>
    <div class="twf-card-body">
        @using (Html.BeginForm("Index", "ShowRequest", FormMethod.Get, new { @class = "twf-form" }))
        {
            if (!string.IsNullOrEmpty(ViewBag.Message as string))
            {
                <div class="twf-alert twf-alert-danger">@ViewBag.Message</div>
            }

            <div class="twf-grid" style="grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; align-items:end; margin-bottom:16px;">
                <div class="twf-field">
                    <label class="twf-label">@MyTime3.Content.PersianString.FromDate</label>
                    <input type="text" name="fromDate" class="twf-input twf-num datepicker-farsi" dir="ltr" value="@(Model != null ? Model.fromDate : "")" placeholder="1405/01/01" required />
                </div>
                <div class="twf-field">
                    <label class="twf-label">@MyTime3.Content.PersianString.ToDate</label>
                    <input type="text" name="toDate" class="twf-input twf-num datepicker-farsi" dir="ltr" value="@(Model != null ? Model.toDate : "")" placeholder="1405/12/29" required />
                </div>
                <div class="twf-field">
                    <button type="submit" class="twf-btn twf-btn-primary">@MyTime3.Content.PersianString.OK</button>
                </div>
            </div>
        }

        <div class="twf-table-wrap">
            <table class="twf-table">
                <thead>
                    <tr>
                        <th>@MyTime3.Content.PersianString.BadgeNumber</th>
                        <th>@MyTime3.Content.PersianString.Name</th>
                        <th>@MyTime3.Content.PersianString.WorkflowType</th>
                        <th>@MyTime3.Content.PersianString.Type</th>
                        <th>@MyTime3.Content.PersianString.From</th>
                        <th>@MyTime3.Content.PersianString.To</th>
                        <th>@MyTime3.Content.PersianString.WaitForTitle</th>
                        <th>@MyTime3.Content.PersianString.AcceptedTitle</th>
                        <th>@MyTime3.Content.PersianString.CanceledTitle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Requests != null)
                    {
                        foreach (MyTime3.Models.Request req in Model.Requests)
                        {
                            <tr>
                                <td class="twf-num">@req.BadgeNumber</td>
                                <td>@req.Name</td>
                                <td><span class="twf-badge">@req.WorkflowName</span></td>
                                <td>@req.TypeName</td>
                                <td class="twf-num" dir="ltr">@req.From</td>
                                <td class="twf-num" dir="ltr">@req.To</td>
                                <td>@req.WaitForTitle</td>
                                <td><span class="twf-badge twf-badge-success">@req.AcceptedTitles</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(req.CanceledTitle))
                                    {
                                        <span class="twf-badge twf-badge-danger">@req.CanceledTitle</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
