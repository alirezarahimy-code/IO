@model string
<select name="Descriptions" class="twf-input" id="comboDutyD">
    @if (ViewBag.DutyDescriptions != null)
    {
        foreach (SelectListItem desc in ViewBag.DutyDescriptions)
        {
            <option value="@desc.Text">@desc.Text</option>
        }
    }
    <option value="--" id="OtherDutyOption">@MyTime3.Content.PersianString.Other</option>
</select>
<input type="text" id="textDutyD" class="twf-input" style="display: none; margin-top: 6px;" />

<script type="text/javascript">
    (function () {
        var combo = document.getElementById('comboDutyD');
        var text = document.getElementById('textDutyD');
        if (!combo || !text) return;
        combo.addEventListener('change', function () {
            var selected = combo.options[combo.selectedIndex];
            if (selected && selected.id === 'OtherDutyOption') {
                combo.setAttribute('name', 'NotTarget');
                text.setAttribute('name', 'Descriptions');
                text.style.display = 'block';
                text.focus();
            } else {
                text.setAttribute('name', 'NotTarget');
                text.style.display = 'none';
                combo.setAttribute('name', 'Descriptions');
            }
        });
    })();
</script>
