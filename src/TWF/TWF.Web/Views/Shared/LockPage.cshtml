@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@MyTime3.Content.PersianString.AppName</title>
    <link href="~/Content/twf-industrial-ui.css" rel="stylesheet" />
</head>
<body class="twf-auth-page">
    <div class="twf-auth-card">
        <div class="twf-auth-header">
            <h1>@MyTime3.Content.PersianString.AppName</h1>
            <p>وضعیت مجوز سامانه (Zero-Lock Active)</p>
        </div>
        <div class="twf-auth-body">
            <div class="twf-alert twf-alert-success">
                سامانه در حالت بدون محدودیت قفل سخت‌افزاری (Zero-Lock) فعال است.
            </div>
            <a href="~/Login/RetryCheck" class="twf-btn twf-btn-primary" style="width: 100%;">
                @MyTime3.Content.PersianString.TryAgain
            </a>
        </div>
    </div>
</body>
</html>
