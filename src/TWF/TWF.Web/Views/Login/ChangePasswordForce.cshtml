@using MyTime3.Content;
@model MyTime3.Models.ChangePasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@PersianString.ChangePassword — @PersianString.AppName</title>
    <link href="~/Content/twf-industrial-ui.css" rel="stylesheet" />
</head>
<body class="twf-auth-page">
    <div class="twf-auth-card" style="max-width: 480px;">
        <div class="twf-auth-header">
            <h1>@PersianString.ChangePassword</h1>
            <p>الزام امنیتی تغییر کلمه عبور</p>
        </div>

        <div class="twf-auth-body">
            @if (Model != null && !string.IsNullOrEmpty(Model.Message))
            {
                <div class="twf-alert twf-alert-warn">
                    @Model.Message
                </div>
            }

            @using (Html.BeginForm("ChangePasswordForce", "Login", FormMethod.Post))
            {
                <div class="twf-form-group">
                    <label for="OldPassword">@PersianString.OldPass</label>
                    <input type="password" id="OldPassword" name="OldPassword" class="twf-input" required="required" autofocus="autofocus" />
                </div>

                <div class="twf-form-group">
                    <label for="NewPassword">@PersianString.NewPass</label>
                    <input type="password" id="NewPassword" name="NewPassword" class="twf-input" required="required" />
                </div>

                <div class="twf-form-group">
                    <label for="ConfirmNewPassword">@PersianString.ConfirmNewPass</label>
                    <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" class="twf-input" required="required" />
                </div>

                <div style="margin-top: 20px; display: flex; gap: 10px;">
                    <button type="submit" class="twf-btn twf-btn-primary" style="flex: 1;">
                        @PersianString.Save
                    </button>
                    <a href="~/Login/Logout" class="twf-btn twf-btn-secondary">
                        @PersianString.Logout
                    </a>
                </div>
            }
        </div>
    </div>
</body>
</html>
