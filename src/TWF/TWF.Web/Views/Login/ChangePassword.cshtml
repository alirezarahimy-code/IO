@using MyTime3.Content;
@model MyTime3.Models.ChangePasswordModel
@{
    ViewBag.Title = PersianString.ChangePassword;
}

<div class="twf-card" style="max-width: 560px; margin: 0 auto;">
    <div class="twf-card-header">
        <h3 class="twf-card-title">@PersianString.ChangePassword</h3>
    </div>

    <div class="twf-card-body">
        @if (Model != null && !string.IsNullOrEmpty(Model.Message))
        {
            string alertClass = (ViewBag.Success != null && (bool)ViewBag.Success)
                ? "twf-alert twf-alert-success"
                : "twf-alert twf-alert-error";
            <div class="@alertClass">
                @Model.Message
            </div>
        }

        @using (Html.BeginForm("ChangePassword", "Login", FormMethod.Post))
        {
            <div class="twf-form-group">
                <label for="OldPassword">@PersianString.OldPass</label>
                <input type="password" id="OldPassword" name="OldPassword" class="twf-input" required="required" />
            </div>

            <div class="twf-form-group">
                <label for="NewPassword">@PersianString.NewPass</label>
                <input type="password" id="NewPassword" name="NewPassword" class="twf-input" required="required" />
            </div>

            <div class="twf-form-group">
                <label for="ConfirmNewPassword">@PersianString.ConfirmNewPass</label>
                <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" class="twf-input" required="required" />
            </div>

            <div style="margin-top: 20px; display: flex; gap: 10px;">
                <button type="submit" class="twf-btn twf-btn-primary">
                    @PersianString.Save
                </button>
                <a href="~/Home/Index" class="twf-btn twf-btn-secondary">
                    @PersianString.HomePage
                </a>
            </div>
        }
    </div>
</div>
