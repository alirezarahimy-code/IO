@{
    ViewBag.Title = MyTime3.Content.PersianString.About;
}

<div class="twf-panel">
    <div class="twf-panel-header">
        <h2 class="twf-panel-title">@Html.Raw(MyTime3.Content.PersianString.About)</h2>
        <span class="twf-badge twf-badge-success">بدون قفل سخت‌افزاری (Zero-Lock)</span>
    </div>
    <div class="twf-panel-body">
        <div class="twf-grid-2">
            <div>
                <h3 style="margin-top: 0; color: var(--twf-text-primary);">@Html.Raw(MyTime3.Content.PersianString.bode5)</h3>
                <p style="line-height: 1.8; color: var(--twf-text-secondary);">@Html.Raw(MyTime3.Content.PersianString.bode5Descriptions1)</p>
                <p style="line-height: 1.8; color: var(--twf-text-secondary);">@Html.Raw(MyTime3.Content.PersianString.bode5Descriptions2)</p>
                <div style="margin-top: 16px;">
                    <img src="@Url.Action("MyBanner", "Home", new { index = 2 })" alt="Arm1" style="max-height: 72px;" />
                </div>
            </div>
            <div>
                <div style="margin-bottom: 16px;">
                    <img width="96" src="@Url.Action("MyBanner", "Home", new { index = 3 })" alt="Arm2" />
                </div>
                <div class="twf-alert twf-alert-info">
                    <div>@Html.Raw(MyTime3.Content.PersianString.bode5Tel)</div>
                    <div style="margin-top: 8px;">@Html.Raw(MyTime3.Content.PersianString.bode5Fac)</div>
                </div>
            </div>
        </div>
        <hr style="border: 0; border-top: 1px solid var(--twf-border); margin: 20px 0;" />
        <div style="font-size: 12px; color: var(--twf-text-muted); text-align: center;">
            <div>@Html.Raw(MyTime3.Content.PersianString.bode5Copy1)</div>
            <div style="margin-top: 4px;">@Html.Raw(MyTime3.Content.PersianString.bode5Copy)</div>
        </div>
    </div>
</div>
