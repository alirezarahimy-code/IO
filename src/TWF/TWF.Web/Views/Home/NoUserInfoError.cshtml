@{
    ViewBag.Title = MyTime3.Content.PersianString.Error;
}

<div class="twf-panel">
    <div class="twf-panel-header">
        <h2 class="twf-panel-title">@MyTime3.Content.PersianString.Error</h2>
    </div>
    <div class="twf-panel-body">
        <div class="twf-alert twf-alert-danger">
            <strong>@MyTime3.Content.PersianString.Error:</strong>
            <span>اطلاعات پرسنلی یا سمت سازمانی کاربر در سامانه پرسنلی (T5 / Personnel) یافت نشد.</span>
        </div>
        <div style="margin-top: 16px;">
            <a href="~/Login/Logout" class="twf-btn twf-btn-secondary">@MyTime3.Content.PersianString.Exit</a>
        </div>
    </div>
</div>
