@using Aria.Web.Content
@{
    ViewData["Title"] = OriginalAboutContent.Title;
}
<section class="twf-auth-header" aria-labelledby="about-title">
    <h1 id="about-title">@OriginalAboutContent.Title</h1>
</section>
<section class="twf-auth-body">
    <h2>@OriginalAboutContent.Company</h2>
    <p>@OriginalAboutContent.Description1</p>
    <p>@OriginalAboutContent.Description2</p>
    <p><img src="/assets/aria-about-arm.png" width="295" height="55" alt="نشان اصلی سامانهٔ بعد پنجم" /></p>
    <p><img src="/assets/aria-about-logo.png" width="100" alt="نشان شرکت سامانه‌های بعد پنجم" /></p>
    <p>@OriginalAboutContent.Phone</p>
    <p>@OriginalAboutContent.Fax</p>
    <small>@OriginalAboutContent.Copyright</small>
</section>
