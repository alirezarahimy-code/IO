<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Aria.Request.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Web/Aria.Web.csproj" />
    <!-- Test-only ADO.NET DataTable doubles; no SQL driver, rows or secrets. -->
    <Compile Include="../Profile.Tests/ProfileDoubles.cs" Link="ProfileDoubles.cs" />
    <None Update="original-request-schema.fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
