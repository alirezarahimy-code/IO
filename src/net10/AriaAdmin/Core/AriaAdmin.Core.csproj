<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AriaAdmin.Core</AssemblyName>
    <RootNamespace>AriaAdmin.Core</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitional source links: compile all 25 actual Domain/Application files,
         not a handwritten mock or a copy silently diverging from the rewrite.
         Originals are never edited; remove links before a standalone release. -->
    <Compile Include="../../../T5Web/T5Web.Domain/**/*.cs"
             Exclude="../../../T5Web/T5Web.Domain/obj/**;../../../T5Web/T5Web.Domain/bin/**"
             Link="LegacyDomain/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../T5Web/T5Web.Application/**/*.cs"
             Exclude="../../../T5Web/T5Web.Application/obj/**;../../../T5Web/T5Web.Application/bin/**"
             Link="LegacyApplication/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Owned pure original-Admin report display adapter; no other product link. -->
    <Compile Include="Compatibility/OriginalReportTime.cs" />
  </ItemGroup>
</Project>
