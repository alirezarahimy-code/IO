<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Legacy EF-format string is accepted as-is; see MvcApplication.BuildConnectionString. -->
    <add key="T5CnnStr" value="data source=.;initial catalog=ReportT5V3;integrated security=True;MultipleActiveResultSets=True" />
    <!-- Second catalog: people, departments, titles, devices, gates (docs/09).
         When it is empty the portal assumes one database holds everything. -->
    <add key="PersonnelCnnStr" value="data source=.;initial catalog=Personnel;integrated security=True;MultipleActiveResultSets=True" />
    <!-- Product identity: the rewrite is registered as «آریا ادمین» / Aria Admin.
         The folder name (T5Web) is a path, not the product (docs/01, README). -->
    <add key="PortalName" value="آریا ادمین" />
    <add key="PortalProductCode" value="ARIA-ADMIN" />
    <add key="PortalVersion" value="5.0" />
    <!-- Cut-over switch, see docs/08-runbook.md. portal | coexist | legacy (default: coexist). -->
    <add key="T5WebMode" value="coexist" />
    <add key="T5WebLegacyUrl" value="" />
  </appSettings>

  <system.web>
    <!-- Windows/Negotiate: the portal has no password store of its own. -->
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>

    <compilation debug="false" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="20480" executionTimeout="600" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Shared/Error" />

    <!-- Anti-CSRF token cookie must never leave over plain HTTP in production. -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />

    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Linq" />
      </namespaces>
    </pages>
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <httpProtocol>
      <customHeaders>
        <!-- Offline console: no third-party assets, so the policy can be strict. -->
        <add name="Content-Security-Policy" value="default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
        <!-- One source file really does live in Content\ (AriaAdminBranding.cs,
             compiled - T30). It must never be downloadable, and neither must a
             folder that was copied by hand instead of published: source on a web
             server is a copy of the product's source in an attacker's hands. -->
        <fileExtensions>
          <add fileExtension=".cs"     allowed="false" />
          <add fileExtension=".csproj" allowed="false" />
          <add fileExtension=".sln"    allowed="false" />
          <add fileExtension=".user"   allowed="false" />
          <add fileExtension=".pdb"    allowed="false" />
          <add fileExtension=".bak"    allowed="false" />
          <add fileExtension=".log"    allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.7.0" newVersion="5.2.7.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
