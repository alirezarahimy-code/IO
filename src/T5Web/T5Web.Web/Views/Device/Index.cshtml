@model IReadOnlyList<T5Web.Domain.Models.DeviceRow>
@using T5Web.Application.Services
@{
    ViewBag.Title = "دستگاه‌های تردد";
    bool canEdit = ViewBag.CanEdit != null && (bool)ViewBag.CanEdit;
    var gates = ViewBag.Gates as IReadOnlyList<T5Web.Domain.Models.GateRow>;
    bool canSync = ViewBag.CanSync != null && (bool)ViewBag.CanSync;
    var commands = ViewBag.Commands as IReadOnlyList<DeviceCommand>;
    var transport = ViewBag.Transport as DeviceTransport;
    bool canSend = transport != null && transport.IsConfigured;
    var queue = ViewBag.Queue as IReadOnlyList<T5Web.Domain.Models.DeviceCommandTicket>;
}
<div class="panel">
    <div class="panel__head">
        <h2>فهرست دستگاه‌ها (@Model.Count)</h2>
        @if (gates != null)
        {
            <span class="muted u-sm">@gates.Count درب تعریف‌شده</span>
        }
    </div>
    <div class="transport @(canSend ? "transport--on" : "transport--off")">
        @(transport == null ? "ارتباط با دستگاه تنظیم نشده است." : transport.DescribeFa)
        @if (!canSend)
        {
            <span class="muted u-sm">برای فعال‌کردن، کلید <code>T5WebDeviceTransport</code> را در Web.config ست کنید
            (<code>link5:legacy</code> یا <code>link5:http://server:15222/Device/</code>).</span>
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty">دستگاهی ثبت نشده است.</div>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th class="num">شماره</th>
                    <th>نام</th>
                    <th>درب</th>
                    <th>نوع اتصال</th>
                    <th>نشانی</th>
                    <th>سریال</th>
                    <th>آخرین تردد</th>
                    @if (canEdit)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var device in Model)
            {
                <tr>
                    <td class="num">@device.MachineNumber</td>
                    <td>@device.MachineName</td>
                    <td>@device.GateName</td>
                    <td>@device.ConnectionTypeFa</td>
                    <td class="mono">@device.Endpoint</td>
                    <td class="mono">@device.SerialNo</td>
                    <td class="num">@(device.LastStamp.HasValue ? PersonnelService.ToJalali(device.LastStamp) : "—")</td>
                    @if (canEdit)
                    {
                        <td class="nowrap">
                            <a class="btn btn--ghost" href="@Url.Action("Edit", "Device", new { id = device.MachineNumber })">تنظیمات</a>
                            @if (canSync && canSend && commands != null && commands.Count > 0)
                            {
                                <form method="post" action="@Url.Action("Command", "Device")" class="inline" data-confirm="true">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="machineNumber" value="@device.MachineNumber" />
                                    <select name="command" aria-label="دستور دستگاه">
                                        @foreach (var command in commands)
                                        {
                                            <option value="@command.Code">@command.TitleFa</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn--ghost">اجرا</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@if (queue != null && queue.Count > 0)
{
    <div class="panel">
        <div class="panel__head">
            <h2>صف دستورهای دستگاه</h2>
            <span class="muted u-sm">آخرین @queue.Count دستور · سرویس دسکتاپ صف را برمی‌دارد</span>
        </div>
        <table class="grid">
            <thead>
                <tr>
                    <th class="num">شماره</th>
                    <th class="num">دستگاه</th>
                    <th>دستور</th>
                    <th>وضعیت</th>
                    <th>ثبت‌کننده</th>
                    <th>زمان (UTC)</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var ticket in queue)
            {
                <tr>
                    <td class="num mono">@ticket.Id</td>
                    <td class="num">@ticket.MachineNumber</td>
                    <td class="mono">@ticket.Command</td>
                    <td><span class="tag">@ticket.StatusFa</span></td>
                    <td class="u-sm">@ticket.RequestedBy</td>
                    <td class="num mono">@ticket.RequestedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
