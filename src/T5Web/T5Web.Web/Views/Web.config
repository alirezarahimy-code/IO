<?xml version="1.0" encoding="utf-8"?>
<!--
  Views are separate from the application root in ASP.NET MVC on .NET Framework: this
  file is what makes a Razor page derive from System.Web.Mvc.WebViewPage (so @model,
  ViewBag, Url and Html exist at all) and imports the namespaces the views use.

  Without it every view compiles against System.Web.WebPages.WebPage and the first
  request to any screen answers 500 with
      error CS0103: The name 'model' does not exist in the current context
  which is what the IIS job reported before this file existed (BUG-38).

  The version numbers must match the assemblies the pinned engine ships
  (T5Web [3.5.7]\App\bin: System.Web.Mvc 5.2.7.0). A three-part mismatch here is not a
  warning: it is FileLoadException 0x80131040 on every page, because the Razor host
  factory is resolved from this file. T40 compares this file with the file on disk.

  It is deliberately a copy of the standard MVC 5 file, not an import of
  System.Web.WebPages.Razor's default: the deployment is air-gapped, and a file that
  arrives with a NuGet package is a file the customer's copy might not have.
-->
<configuration>
  <configSections>
    <sectionGroup name="system.web.webPages.razor" type="System.Web.WebPages.Razor.Configuration.RazorWebSectionGroup, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35">
      <section name="host" type="System.Web.WebPages.Razor.Configuration.HostSection, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" />
      <section name="pages" type="System.Web.WebPages.Razor.Configuration.RazorPagesSection, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <system.web.webPages.razor>
    <host factoryType="System.Web.Mvc.MvcWebRazorHostFactory, System.Web.Mvc, Version=5.2.7.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
    <pages pageBaseType="System.Web.Mvc.WebViewPage">
      <namespaces>
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="T5Web.Domain" />
        <add namespace="T5Web.Domain.Models" />
        <add namespace="T5Web.Web" />
        <add namespace="T5Web.Web.Security" />
        <add namespace="T5Web.Web.Content" />
        <add namespace="T5Web.Application.Services" />
      </namespaces>
    </pages>
  </system.web.webPages.razor>

  <!-- Views are compiled in full, not trusted: they are C# like any other file. -->
  <system.web>
    <compilation debug="false" targetFramework="4.7.2" />
    <pages validateRequest="true" />
  </system.web>

  <!-- IIS must hand the .cshtml extension to ASP.NET and never serve it as a file. -->
  <system.webServer>
    <handlers>
      <remove name="BlockViewHandler" />
      <add name="BlockViewHandler" path="*.cshtml" verb="*" preCondition="integratedMode"
           type="System.Web.HttpNotFoundHandler, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
    </handlers>
  </system.webServer>
</configuration>
