@{
    ViewBag.Title = "پیکربندی ناقص";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string reason = ViewData["Reason"] as string;
}
<div class="gate" style="border-top-color: var(--amber)">
    <h1>پورتال پیکربندی نشده است</h1>
    <p>@(string.IsNullOrWhiteSpace(reason) ? "رشته اتصال پایگاه‌داده در Web.config تنظیم نشده است." : reason)</p>
    <p class="muted" style="font-size:12.5px">
        کلید <code>T5CnnStr</code> در <code>appSettings</code> باید به پایگاه‌داده T5 اشاره کند.
        قالب قدیمی Entity Framework نیز پذیرفته می‌شود.
    </p>
</div>
