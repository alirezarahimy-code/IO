@model T5Web.Domain.Models.PersonnelRow
@using T5Web.Application.Services
@{
    ViewBag.Title = "ویرایش پرسنل";
    var departments = ViewBag.Departments as IEnumerable<System.Web.Mvc.SelectListItem>;
    var empTypes = ViewBag.EmpTypes as IEnumerable<System.Web.Mvc.SelectListItem>;
}
<form method="post" action="@Url.Action("Edit", "Personnel")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BadgeNumber" value="@Model.BadgeNumber" />

    <div class="panel">
        <div class="panel__head">
            <h2>@PersonnelService.NormalizeDisplay(Model.FullName) · شماره @Model.BadgeNumber</h2>
            <span class="tag tag--mute">شماره پرسنلی قابل تغییر نیست</span>
        </div>
        <div class="panel__body">
            <div class="form-grid">
                <div class="field">
                    <label for="FirstName">نام</label>
                    <input type="text" id="FirstName" name="FirstName" value="@Model.FirstName" maxlength="50" required />
                </div>
                <div class="field">
                    <label for="LastName">نام خانوادگی</label>
                    <input type="text" id="LastName" name="LastName" value="@Model.LastName" maxlength="50" required />
                </div>
                <div class="field">
                    <label for="FatherName">نام پدر</label>
                    <input type="text" id="FatherName" name="FatherName" value="@Model.FatherName" maxlength="50" />
                </div>
                <div class="field">
                    <label for="NationalNo">کد ملی</label>
                    <input type="text" id="NationalNo" name="NationalNo" value="@Model.NationalNo" maxlength="12" inputmode="numeric" />
                </div>
                <div class="field">
                    <label for="Phone">تلفن</label>
                    <input type="text" id="Phone" name="Phone" value="@Model.Phone" maxlength="20" />
                </div>
                <div class="field">
                    <label for="Email">پست الکترونیک</label>
                    <input type="text" id="Email" name="Email" value="@Model.Email" maxlength="50" />
                </div>
                <div class="field">
                    <label for="DeptId">واحد سازمانی</label>
                    <select id="DeptId" name="DeptId" required>
                        @if (departments != null)
                        {
                            foreach (var item in departments)
                            {
                                <option value="@item.Value" selected="@(item.Value == Model.DeptId.ToString() ? "selected" : null)">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="EmpTypeId">نوع استخدام</label>
                    <select id="EmpTypeId" name="EmpTypeId">
                        @if (empTypes != null)
                        {
                            foreach (var item in empTypes)
                            {
                                <option value="@item.Value" selected="@(item.Value == Model.EmpTypeId.ToString() ? "selected" : null)">@item.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-grid" style="margin-top:6px">
                <div class="field">
                    <label>تاریخ استخدام (میلادی)</label>
                    <input type="text" name="HiredDateDisplay" value="@(Model.HiredDate.HasValue ? Model.HiredDate.Value.ToString("yyyy-MM-dd") : "")" disabled />
                </div>
                <div class="field">
                    <label>تاریخ پایان کار (میلادی)</label>
                    <input type="text" name="FiredDateDisplay" value="@(Model.FiredDate.HasValue ? Model.FiredDate.Value.ToString("yyyy-MM-dd") : "")" disabled />
                </div>
                <div class="field">
                    <label>کاربر وب</label>
                    <label class="check">
                        <input type="checkbox" name="IsWebUser" value="true" checked="@(Model.IsWebUser ? "checked" : null)" />
                        <span>اجازه ورود به پورتال (نیازمند WebUser در پایگاه‌داده)</span>
                    </label>
                </div>
                <div class="field">
                    <label>دستگاه</label>
                    <label class="check">
                        <input type="checkbox" name="DeviceEnabled" value="true" checked="@(Model.DeviceEnabled ? "checked" : null)" />
                        <span>فعال روی دستگاه تردد</span>
                    </label>
                </div>
            </div>

            <div class="notice notice--info" style="margin-top:14px">
                تاریخ‌ها فقط خواندنی هستند: تغییر تاریخ استخدام/پایان کار روی محاسبه مانده مرخصی اثر می‌گذارد
                و باید از ماژول قرارداد و پایان خدمت انجام شود، نه از این فرم.
            </div>
        </div>
    </div>

    <div style="display:flex; gap:10px">
        <button type="submit" class="btn btn--primary">ثبت تغییرات</button>
        <a href="@Url.Action("Index", "Personnel")" class="btn">بازگشت</a>
    </div>
</form>
